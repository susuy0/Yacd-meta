    static class FutoonApi {
        static class SessionExpired extends IOException { }
        final String backend;
        final FutoonStore.Session persistence;
        int refreshes;
        String cookies;
        FutoonApi(String address, FutoonStore.Session session) {
            backend = address; persistence = session;
            session.owner.clientCreations++;
            refreshSession();
            Runnable hook = session.owner.store.afterClientConstruction;
            session.owner.store.afterClientConstruction = null;
            if (hook != null) hook.run();
        }
        void refreshSession() { refreshes++; cookies = persistence.owner.store.cookies; }
        static class Order {
