    }
    static class FutoonBusinessApi {
        final FutoonApi api;
        final String backend;
        final Set<String> tickets = new HashSet<>();
        FutoonBusinessApi(FutoonApi client, String address) {
            api = client; backend = address; client.persistence.owner.engineCreations++;
        }
        JSONObject call(String operation, JSONObject params) throws IOException {
            if (!backend.equals(api.persistence.owner.store.address())) throw new IOException("Stale engine scope");
            api.persistence.owner.businessCalls++;
            JSONObject result = new JSONObject().put("backend", backend);
            if (operation.equals("module.editor") || operation.equals("batch.options")) {
                String ticket = operation + ":" + UUID.randomUUID();
                tickets.add(ticket); result.put("ticket", ticket);
            } else if (operation.equals("form.save") || operation.equals("batch.run")) {
                if (!tickets.contains(params.getString("ticket"))) throw new IOException("Unknown form or batch ticket");
                result.put("saved", true);
            }
            return result;
        }
    }
    static class FutoonStore {
        final ScopeCheck owner;
        String current = "https://backend-a.example/admin/";
        String cookies = "PHPSESSID=captcha";
        Runnable afterClientConstruction;
        FutoonStore(ScopeCheck value) { owner = value; }
