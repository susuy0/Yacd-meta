    void collapse() { collapsed++; }
    void toast(String text) { lastToast = text; }
    String dispatchBusiness(String operation, JSONObject params) throws Exception {
        // Model nativeCall's already-captured scope, then run its real production dispatch.
        final String backend = store.address();
        final int requestGeneration = generation;
        dispatchCaptured.countDown();
        // __PRODUCTION_DISPATCH__
    }

    // __PRODUCTION_METHODS__

    static int assertions;
    static void check(boolean condition, String message) {
        assertions++;
        if (!condition) throw new AssertionError(message);
    }
    static FutoonApi.Order order(String id) { return new FutoonApi.Order(new JSONObject().put("trade_no", id)); }

    public static void main(String[] args) throws Exception {
        ScopeCheck fixture = new ScopeCheck();
        fixture.activeOrder = "SAME";
        fixture.photos.add(new File("old-proof"));
        fixture.downloading.put("old", new Object());
        FutoonStore.setDraft(0, fixture.backendAddress, order("SAME"), "", 8);
        NativePanelView old = fixture.panel;
        fixture.changeBackendScope("https://backend-b.example/admin/", true);
        fixture.store.current = "https://backend-b.example/admin/";
        check(fixture.generation == 4, "Backend change must invalidate asynchronous results");
        check(fixture.photos.isEmpty() && fixture.downloading.isEmpty(), "Old evidence or downloads survived");
        check(fixture.activeOrder.isEmpty(), "Old order survived backend change");
        check(fixture.pickerGeneration == -1 && fixture.exportGeneration == -1, "Pending selectors survived");
        check(fixture.choosing, "An outstanding picker must retain its reservation until its result arrives");
        check(FutoonStore.draft == null, "Old backend global draft survived");
        check(fixture.savedBackend.equals("https://backend-a.example/admin/"), "Navigation saved under new backend");
        check(old.hidden && !old.closed, "Old environment disposed inside its own configure stack");
        AndroidUtilities.flush();
        check(old.closed && old.options.contains("false") && fixture.panel != old, "Old live panel memory retained");
        fixture.prepareEvidence("{\"trade_no\":\"SAME\"}", "new");
        check(fixture.photos.isEmpty(), "Same order number reused another backend's evidence");
        check(FutoonStore.draft.address.equals(fixture.backendAddress), "New draft has wrong backend");

        File proof = File.createTempFile("futoon-scope-proof-", ".jpg");
        proof.deleteOnExit();
        fixture.photos.add(proof);
        String active = fixture.activeOrder;
        int previousSync = fixture.synced;
        for (String malformed : new String[]{"{}", "not-json"}) {
            fixture.sendEvidence(malformed, "bad");
            check(fixture.host.launch.sent == 0 && fixture.collapsed == 0, "Invalid order reached send preview");
            check(fixture.synced == previousSync && fixture.activeOrder.equals(active), "Invalid order mutated draft");
        }
        fixture.sendEvidence("{\"trade_no\":\"SAME\"}", "valid control");
        check(fixture.host.launch.sent == 1 && fixture.collapsed == 1, "Valid control did not reach the preview fixture");
        fixture.alive = false;
        try {
            fixture.prepareEvidence("{\"trade_no\":\"OTHER\"}", "");
            throw new AssertionError("Inactive account accepted evidence");
        } catch (IOException expected) { }
        check(fixture.activeOrder.equals(active), "Inactive account changed draft");

        ScopeCheck external = new ScopeCheck();
        FutoonStore.setDraft(0, "https://backend-b.example/admin/", order("B"), "", 8);
        external.store.current = "https://backend-b.example/admin/";
        external.changeBackendScope(external.store.address(), false);
        check(FutoonStore.draft != null && FutoonStore.draft.address.equals(external.store.current), "Another panel's new draft was cleared");
        external.photos.add(new File("current-proof"));
        int unchangedGeneration = external.generation;
        external.changeBackendScope(external.store.current, false);
        check(external.generation == unchangedGeneration && external.photos.size() == 1, "Unchanged endpoint discarded evidence");
        external.store.current = "https://backend-c.example/admin/";
        try {
            external.prepareEvidence("{\"trade_no\":\"OTHER\"}", "");
            throw new AssertionError("Externally changed backend accepted stale evidence");
        } catch (IOException expected) { }
        check(external.photos.size() == 1, "Stale request mutated evidence before failing");

        ScopeCheck queued = new ScopeCheck();
        AtomicReference<Throwable> rejected = new AtomicReference<>();
        Thread stale = new Thread(() -> {
            try { queued.dispatchBusiness("order.action", new JSONObject().put("trade_no", "SAME")); }
            catch (Throwable error) { rejected.set(error); }
        }, "futoon-stale-backend-request");
        synchronized (queued) {
            stale.start();
            check(queued.dispatchCaptured.await(5, TimeUnit.SECONDS), "Request did not capture backend A");
            long deadline = System.nanoTime() + TimeUnit.SECONDS.toNanos(5);
            while (stale.getState() != Thread.State.BLOCKED && System.nanoTime() < deadline) Thread.yield();
            check(stale.getState() == Thread.State.BLOCKED, "A request did not wait for the dispatch monitor");
            queued.changeBackendScope("https://backend-b.example/admin/", false);
            queued.store.current = "https://backend-b.example/admin/";
        }
        stale.join(5000);
        check(!stale.isAlive(), "Stale dispatch did not finish");
        check(rejected.get() instanceof IOException, "Queued A request was not rejected after switching to B");
        check(queued.clientCreations == 0 && queued.engineCreations == 0 && queued.businessCalls == 0,
                "Stale request reached B client construction or dispatch");
        JSONObject control = new JSONObject(queued.dispatchBusiness("order.action", new JSONObject()));
        check(control.getString("backend").equals(queued.backendAddress) && queued.businessCalls == 1,
                "Current B scope did not reach its own business client");

        ScopeCheck tickets = new ScopeCheck();
        JSONObject editor = new JSONObject(tickets.dispatchBusiness("module.editor", new JSONObject()));
        FutoonBusinessApi originalEngine = tickets.business;
        FutoonApi originalApi = tickets.api;
        int refreshed = originalApi.refreshes;
        tickets.store.cookies = "admin_token=new-shared-login";
        JSONObject saved = new JSONObject(tickets.dispatchBusiness("form.save", new JSONObject().put("ticket", editor.getString("ticket"))));
        check(saved.getBoolean("saved") && tickets.business == originalEngine && tickets.api == originalApi,
                "Form save lost the preceding editor's engine or ticket");
        check(tickets.clientCreations == 1 && tickets.engineCreations == 1,
                "Same-backend dispatch reconstructed the API or business engine");
        check(originalApi.refreshes == refreshed + 1 && originalApi.cookies.equals(tickets.store.cookies),
                "Same-backend dispatch failed to refresh shared cookies");
        JSONObject options = new JSONObject(tickets.dispatchBusiness("batch.options", new JSONObject()));
        JSONObject batch = new JSONObject(tickets.dispatchBusiness("batch.run", new JSONObject().put("ticket", options.getString("ticket"))));
        check(batch.getBoolean("saved") && tickets.business == originalEngine,
                "Batch run lost the preceding options ticket");

        tickets.changeBackendScope("https://backend-b.example/admin/", false);
        tickets.store.current = tickets.backendAddress;
        check(tickets.api == null && tickets.business == null, "Backend switch retained the old API or engine");
        try {
            tickets.dispatchBusiness("form.save", new JSONObject().put("ticket", editor.getString("ticket")));
            throw new AssertionError("Backend B accepted backend A's form ticket");
        } catch (IOException expected) { }
        check(tickets.business != originalEngine && tickets.api != originalApi
                && tickets.business.backend.equals(tickets.backendAddress), "Backend switch failed to replace engine scope");

        ScopeCheck reset = new ScopeCheck();
        JSONObject oldForm = new JSONObject(reset.dispatchBusiness("module.editor", new JSONObject()));
        FutoonApi captchaApi = reset.api;
        reset.business = null; // Successful login/logout invalidates tickets, not captcha/session API state.
        try {
            reset.dispatchBusiness("form.save", new JSONObject().put("ticket", oldForm.getString("ticket")));
            throw new AssertionError("New login retained the previous login's form ticket");
        } catch (IOException expected) { }
        check(reset.api == captchaApi && reset.clientCreations == 1 && reset.engineCreations == 2,
                "Engine invalidation also replaced the captcha/session API");

        ScopeCheck constructing = new ScopeCheck();
        constructing.store.afterClientConstruction = () -> constructing.store.current = "https://backend-b.example/admin/";
        constructing.ensureClient();
        check(constructing.api.backend.equals(constructing.backendAddress)
                && constructing.business.backend.equals(constructing.backendAddress),
                "Concurrent external backend change redirected client or engine construction");
        System.out.println("PASS: " + assertions + " panel scope assertions (extracted production methods)");
