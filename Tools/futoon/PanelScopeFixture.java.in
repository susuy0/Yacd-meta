    int saved, synced, collapsed;
    String savedBackend, lastToast;
    boolean valid() { return alive; }
    void savePanelState() { saved++; savedBackend = backendAddress; }
    void ensurePanel() { if (panel == null) panel = new NativePanelView(); }
    void resize() { }
