    static class AndroidUtilities {
        static final ArrayList<Runnable> queue = new ArrayList<>();
        static void runOnUIThread(Runnable task) { queue.add(task); }
        static void flush() {
            ArrayList<Runnable> pending = new ArrayList<>(queue);
            queue.clear();
            for (Runnable task : pending) task.run();
        }
