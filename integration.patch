+package org.telegram.ui;
+
+import android.content.Context;
+import android.view.View;
+import com.futoonpay.admin.ChatToolsNavigationBridge;
+import com.futoonpay.admin.ChatToolsView;
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.UserConfig;
+import org.telegram.messenger.R;
+import org.telegram.messenger.futoon.FutoonChatPreferences;
+import org.telegram.ui.ActionBar.ActionBar;
+import org.telegram.ui.ActionBar.BaseFragment;
+
+/** Native custom settings, scoped to the selected Telegram account. */
+public final class FutoonChatSettingsActivity extends BaseFragment {
+    private ChatToolsView tools;
+    private final boolean replies;
+    private String selectedTab = "", selectedCategory = "";
+    private Runnable returnToPicker;
+    public FutoonChatSettingsActivity(int account) { this(account, false); }
+    public FutoonChatSettingsActivity(int account, boolean replies) { currentAccount = account; this.replies = replies; }
+    public FutoonChatSettingsActivity(int account, String tab, String category, Runnable onReturn) { this(account, true); selectedTab = tab; selectedCategory = category; returnToPicker = onReturn; }
+    public String selectedTab() { return selectedTab; }
+    public String selectedCategory() { return selectedCategory; }
+    @Override public View createView(Context context) {
+        actionBar.setBackButtonImage(R.drawable.ic_ab_back);
+        actionBar.setTitle("FutoonPay 设置"); actionBar.setAddToContainer(false); actionBar.setVisibility(View.GONE);
+        actionBar.setActionBarMenuOnItemClick(new ActionBar.ActionBarMenuOnItemClick() { @Override public void onItemClick(int id) { if (id == -1) finishFragment(); } });
+        FutoonChatPreferences preferences = FutoonChatPreferences.get(currentAccount);
+        tools = new ChatToolsView(context, new ChatToolsNavigationBridge() {
+            public String load() { return preferences.raw(); }
+            public void save(String json) throws Exception { preferences.save(currentAccount, json); }
+            public String accountLabel() { return "当前 Telegram 账号 · ID " + UserConfig.getInstance(currentAccount).getClientUserId(); }
+            public String selectedTab() { return selectedTab; }
+            public String selectedCategory() { return selectedCategory; }
+            public void rememberSelection(String tab, String category) { selectedTab = tab; selectedCategory = category; }
+            public void manageAt(String tab, String category) {}
+            public void selectReply(String text) {}
+            public void manage() {}
+            public void originalSendOptions() {}
+            public void close() { finishFragment(); }
+        }, false, replies ? "replies" : "home");
+        FutoonThemeBridge.bind(tools, tools::setThemeColors);
+        fragmentView = tools; return fragmentView;
+    }
+    @Override public void onResume() { super.onResume(); if (tools != null) tools.onShown(); }
+    @Override public boolean onBackPressed(boolean invoked) { if (tools != null) { if (invoked) tools.handleBack(); return false; } return super.onBackPressed(invoked); }
+    @Override public void onPause() { if (tools != null) tools.onHidden(); super.onPause(); }
+    @Override public void onFragmentDestroy() {
+        if (tools != null) { tools.close(); tools = null; }
+        super.onFragmentDestroy();
+        Runnable callback = returnToPicker; returnToPicker = null;
+        if (callback != null) AndroidUtilities.runOnUIThread(callback, 200);
+    }
+}
