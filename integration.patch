+    public static void main(String[] args) throws Exception {
+        FutoonQuery.Kind auto = FutoonQuery.Kind.AUTO;
+        check(FutoonQuery.parse(" PID：１２３４ ", auto).kind == FutoonQuery.Kind.PID, "fullwidth PID prefix");
