+                    if (exchange.getRequestMethod().equals("POST")) {
+                        if (!"user".equals(fields.get("user")) || !"correct".equals(fields.get("pass"))) {
+                            send(exchange, 200, "<script>alert('账号密码错误')</script>"); return;
+                        }
