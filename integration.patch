diff --git a/TMessagesProj/src/main/assets/futoon/panel.css b/TMessagesProj/src/main/assets/futoon/panel.css
new file mode 100644
index 0000000..b7eacd2
--- /dev/null
+++ b/TMessagesProj/src/main/assets/futoon/panel.css
@@ -0,0 +1,42 @@
+html,body{margin:0;width:100%;height:100%;overflow:hidden;background:transparent}
+body{font-family:Roboto,"Noto Sans SC",system-ui,sans-serif!important}
+.panel{position:absolute!important;inset:0!important;width:100%;height:100%!important;border-radius:22px;overflow:hidden;display:flex;flex-direction:column}
+.hd{flex:none}.body{overflow:auto;flex:1;min-height:0;overscroll-behavior:contain;padding:14px;display:flex;flex-direction:column;gap:12px}
+.tabbar,.actionbar{flex:none}.tabbar{padding-bottom:max(6px,env(safe-area-inset-bottom))}
+.hd-chat{flex:1;min-width:0}.hd-ctx{flex-wrap:wrap}.hd-top .btn-icon{flex:none}
+.body>.card,.body>.banner,.body>section{flex-shrink:0}
+input,select,textarea{max-width:100%;box-sizing:border-box;min-height:48px;font-size:14px}
+input,textarea,select{width:100%;padding:12px;background:var(--surface-2);border:1px solid var(--line);border-radius:10px;color:var(--text)}
+textarea{min-height:100px;resize:vertical}label{display:flex;flex-direction:column;gap:6px;font-size:12px;color:var(--text-2)}
+button:disabled{opacity:.45;cursor:default}.toolbar{display:flex;gap:8px;flex-wrap:wrap}.toolbar .btn{flex:1;min-width:90px}
+.grid2{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:8px}
+.grid3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}.title{font-size:18px;font-weight:600}
+.order-card{text-align:left;width:100%;padding:12px;background:var(--surface);border:1px solid var(--line);border-radius:14px;display:flex;flex-direction:column;gap:8px;min-height:86px}
+.mono{font-family:ui-monospace,monospace;overflow-wrap:anywhere}.card{padding:12px}.kv{gap:12px}.kv .v{max-width:72%;overflow-wrap:anywhere;white-space:pre-wrap}
+.pagehead{display:flex;align-items:center;gap:8px}.pagehead h2{flex:1;font-size:18px}.plain{font-size:13px;line-height:1.6;white-space:pre-wrap;overflow-wrap:anywhere}
+.thumbs{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.proof{min-width:0}.proof img{width:100%;height:130px;object-fit:cover;border-radius:10px;border:1px solid var(--line)}
+.proof button{min-height:40px}.tags{display:flex;flex-wrap:wrap;gap:6px}.chip.on{background:var(--primary-soft);color:var(--primary-ink)}
+.empty{padding:24px 10px;text-align:center;color:var(--text-2);line-height:1.7}.empty .ic{width:40px;height:40px;color:var(--primary-ink)}
+.hr{margin:5px 0}.scroll-x{overflow:auto}.table{border-collapse:collapse;width:100%;font-size:12px;white-space:nowrap}.table td,.table th{padding:10px;border-bottom:1px solid var(--line);text-align:left}
+.linkrow{display:flex;align-items:center;gap:12px;min-height:56px;width:100%;border-bottom:1px solid var(--line);text-align:left}.linkrow .text{flex:1;min-width:0}.linkrow small{display:block;color:var(--text-2)}
+.flag{font-size:12px;color:var(--text-2);padding:5px 0}.highlight{border-color:var(--primary)!important}
+#toast{position:fixed;z-index:100;bottom:85px;left:18px;right:18px;padding:12px 14px;border-radius:12px;background:#13201a;color:white;display:none;font-size:13px;pointer-events:none}
+.busy{pointer-events:none;opacity:.65}.loading{display:flex;gap:8px;align-items:center;color:var(--text-2);padding:12px}.banner{line-height:1.5}
+.bar{height:4px;background:var(--surface-3);border-radius:4px}.bar>i{display:block;height:100%;background:var(--primary);border-radius:4px}
+.selectline{display:flex;align-items:flex-start;gap:10px}.selectline input{width:22px;height:22px;min-height:22px;margin-top:3px;flex:none}
+.selectline>span{flex:1;min-width:0}.fieldhelp{font-size:12px;color:var(--text-2)}.amount{font-size:28px;font-weight:600;font-variant-numeric:tabular-nums}
+.actionbar .btn{min-width:0}.tab{min-width:0;flex:1;min-height:52px}.idbox{width:100%;display:flex;gap:8px;align-items:center}.idtxt{flex:1;min-width:0}
+.panel button.btn{padding:0 18px;border:1.5px solid transparent;border-radius:14px;font-size:15px;line-height:20px;font-weight:600}
+.panel button.btn.sm{padding:0 12px;font-size:13px;border-radius:12px}
+.panel button.btn-primary{background:var(--primary);color:var(--on-primary)}
+.panel button.btn-danger{background:var(--danger);color:var(--on-danger)}
+.panel button.btn-outline{border-color:var(--line-strong);color:var(--text)}
+.panel button.btn-text{padding:0 10px;color:var(--primary-ink)}
+.panel button.btn-icon{width:40px;height:48px;color:var(--text-2)}
+.panel button.tab{font-size:12px;line-height:16px;color:var(--text-2)}
+.panel button.tab.on{background:var(--primary-soft);color:var(--primary-ink)}
+.panel button.order-card{padding:12px;background:var(--surface);border:1px solid var(--line);border-radius:14px;text-align:left}
+.panel button.tile{padding:12px 6px;background:var(--surface-2);border:1px solid var(--line);border-radius:14px;text-align:center;font-size:13px}
+.panel button.chip{padding:6px 12px;border:1px solid var(--line);border-radius:20px;min-height:36px;font-size:12px}
+.dialog-backdrop{position:absolute;inset:0;background:var(--scrim);display:flex;align-items:center;justify-content:center;z-index:20;padding:18px}.dialog{width:100%;padding:18px;background:var(--surface);border-radius:18px;max-height:90%;overflow:auto}
+@media(min-width:600px){.body{padding:18px 22px}.thumbs{grid-template-columns:repeat(3,minmax(0,1fr))}.grid2{gap:12px}}
diff --git a/TMessagesProj/src/main/assets/futoon/panel.js b/TMessagesProj/src/main/assets/futoon/panel.js
new file mode 100644
index 0000000..c15fdc7
--- /dev/null
+++ b/TMessagesProj/src/main/assets/futoon/panel.js
@@ -0,0 +1,406 @@
+/* Runtime UI derived from the supplied FUTOON design. No production mock data. */
+(()=>{'use strict';
+const $=id=>document.getElementById(id), esc=v=>String(v==null?'':v).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
+const icon=(name,cls='')=>'<svg class="ic '+cls+'" aria-hidden="true"><use href="#i-'+name+'"/></svg>';
+const btn=(text,act,cls='btn-outline',data='')=>'<button type="button" class="btn '+cls+'" data-act="'+act+'" '+data+'>'+text+'</button>';
+const badge=(text,kind='info')=>'<span class="badge '+kind+'">'+esc(text)+'</span>';
+const field=(id,label,value='',type='text',help='')=>'<label>'+esc(label)+'<input id="'+id+'" type="'+type+'" value="'+esc(value)+'" autocomplete="off">'+(help?'<span class="fieldhelp">'+esc(help)+'</span>':'')+'</label>';
+const area=(id,label,value='')=>'<label>'+esc(label)+'<textarea id="'+id+'">'+esc(value)+'</textarea></label>';
+const kv=(k,v,mono=false)=>'<div class="kv"><span class="k">'+esc(k)+'</span><span class="v '+(mono?'mono':'')+'">'+esc(v===''||v==null?'未提供':v)+'</span></div>';
+const note=(text,type='info')=>'<div class="banner '+type+'">'+esc(text)+'</div>';
+const amount=o=>(o.currency||o.currency_code||'CNY')+' '+(o.money??'未提供');
+const labels=['待支付','已支付','已退款','已冻结'],status=o=>labels[Number(o.status)]||'未知状态';
+const S={cfg:{},ctx:{},rev:0,m:null,lookup:'none',active:false,tab:'merchant',page:'',stack:[],error:'',busy:false,orders:[],order:null,total:0,n:1,q:'',kind:'AUTO',filters:{},candidates:[],sourceText:'',sourceMessage:0,photos:[],caption:'',batch:[],batchRunning:false,batchCancel:false,form:null,module:'channels',records:[],record:null,local:{history:[],favorites:[],cases:{},drafts:{},groups:{},targets:[]},seq:0,promises:new Map(),initialized:false};
+function call(op,params={},label='',summary=''){
+ return new Promise((resolve,reject)=>{
+  const id=String(++S.seq);S.promises.set(id,{resolve,reject});
+  if(!window.FutoonNative){S.promises.delete(id);reject(new Error('请在 VineChat 客户端中打开此面板'));return;}
+  window.FutoonNative.post(S.cfg.nonce,JSON.stringify({id,op,params,label,summary}));
+ });
+}
+function toast(text){$('toast').textContent=text;$('toast').style.display='block';clearTimeout(S.toastTimer);S.toastTimer=setTimeout(()=>$('toast').style.display='none',3200);}
+function save(){if(!S.initialized)return;call('local.write',S.local).catch(()=>{});}
+function draft(){
+ if(!S.order)return;S.local.drafts[S.order.trade_no]={order:S.order,caption:S.caption,sourceMessage:S.sourceMessage,sourceContext:S.sourceContext||S.ctx,proofs:S.photos,updated:Date.now()};
+ const keys=Object.keys(S.local.drafts);if(keys.length>50)delete S.local.drafts[keys.sort((a,b)=>S.local.drafts[a].updated-S.local.drafts[b].updated)[0]];save();
+}
+function history(text,kind){
+ S.local.history=[{text,kind,time:Date.now()},...(S.local.history||[]).filter(x=>x.text!==text)].slice(0,30);save();
+}
+function deliveryRow(r){const id=r.draft;if(!id)return;const c=S.local.cases[id]||{};c.sendState=[r.sent?'Telegram 已确认 '+r.sent+' 张凭证':'',r.failed?r.failed+' 张发送失败':'',r.pending?r.pending+' 张发送中':''].filter(Boolean).join('；')||'等待发送结果';c.target=r.dialog;c.message=r.message;S.local.cases[id]=c;}
+async function refreshDeliveries(){try{const rows=await call('delivery.read');Object.values(rows||{}).forEach(deliveryRow);render();}catch(ignored){}}
+function contextLookup(){if(S.ctx.tgid)return lookup();const pid=S.local.groups?.[S.ctx.key];if(pid)return lookup('uid',pid,true);return Promise.resolve();}
+function show(page='',data){S.error='';S.stack.push({page:S.page,form:S.form,record:S.record,scroll:document.querySelector('.body')?.scrollTop||0});S.page=page;if(data)S.record=data;render();}
+function back(){
+ const active=document.activeElement;if(active&&/INPUT|TEXTAREA|SELECT/.test(active.tagName)){active.blur();return;}
+ if(S.form?.dirty){S.modal='discard';render();return;}
+ if(S.page){const x=S.stack.pop();S.page=x?.page||'';S.form=x?.form||null;S.record=x?.record||null;S.error='';render();return;}
+ call('ui.collapse').catch(()=>{});
+}
+async function run(fn){
+ if(S.busy)return;S.busy=true;S.error='';
+ try{const task=fn();render();await task;}catch(e){S.error=e.message||'操作失败';if(e.expired){S.active=false;S.page='login';}}
+ finally{S.busy=false;render();}
+}
+async function lookup(column='telegram_id',value=S.ctx.tgid,manual=false){
+ const rev=S.rev;
+ if(!value){S.lookup='none';render();return;}
+ S.lookup='loading';S.m=null;render();
+ try{const r=await call('merchant.lookup',{column,value});if(rev!==S.rev)return;
+  S.m=r.rows?.[0]||null;S.lookup=S.m?'ok':'unbound';S.manual=manual;
+ }catch(e){if(rev!==S.rev)return;S.m=null;S.lookup='failed';S.error=e.message;if(e.expired)S.active=false;}
+ render();
+}
+function setContext(ctx){
+ if(S.ctx.key===ctx.key)return;
+ S.rev++;S.ctx=ctx;S.m=null;S.lookup=ctx.tgid?'loading':'none';S.manual=false;S.orders=[];S.n=1;S.error='';
+ if(S.form?.dirty){S.pendingReset=true;S.modal='context';}
+ else{S.page='';S.stack=[];S.form=null;S.order=null;S.photos=[];S.caption='';}
+ render();
+ if(S.active)contextLookup();
+}
+function orderCard(o,index,act='order.open'){
+ const match=o.trade_no===S.q?'系统订单号精确命中':o.out_trade_no===S.q?'商户订单号精确命中':o.api_trade_no===S.q?'通道订单号精确命中':'后台返回记录';
+ return '<button class="order-card" data-act="'+act+'" data-index="'+index+'"><div class="rf between g8"><span class="b clamp1">'+esc(o.username||'商户 '+o.uid)+'</span>'+badge(status(o),Number(o.status)===1?'ok':'warn')+'</div><div class="rf between g8"><span class="mono">'+esc(o.trade_no)+'</span><strong>'+esc(amount(o))+'</strong></div><div class="t-cap c2">'+esc(o.addtime||'时间未提供')+' · PID '+esc(o.uid)+'</div><div class="t-cap cp">'+esc(match)+'</div></button>';
+}
+function merchantView(){
+ if(!S.active)return {body:note('登录富通后台后，可以识别当前聊天的商户并查询订单。')+btn('连接富通后台','login.open','btn-primary block')};
+ if(S.lookup==='loading')return {body:'<div class="loading">'+icon('spin','spin')+'正在按 TGID 查询商户…</div>'};
+ if(!S.m)return {body:note(S.lookup==='unbound'?'TGID '+S.ctx.tgid+' 尚未绑定商户':S.lookup==='failed'?'商户查询失败，请重试或手动查询':'当前会话未识别到商户；普通群可以手动指定。',S.lookup==='failed'?'err':'info')+
+  '<div class="empty">'+icon('store')+'<p>按 Telegram 用户 ID 精确查询富通商户</p></div>'+btn('手动查询 TGID / PID','merchant.manual','btn-primary block')+(S.ctx.tgid?btn('重新识别','merchant.refresh','btn-outline block'):'')};
