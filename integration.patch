-    private boolean sameOrder(ArrayList<Long> a, ArrayList<Long> b) {
-        if (a.size() != b.size()) {
-            return false;
-        }
-        for (int i = 0; i < a.size(); ++i) {
-            if (!Objects.equals(a.get(i), b.get(i))) {
