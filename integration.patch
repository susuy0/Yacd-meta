+                            String requestPath = target.getPath();
+                            cookie.setPath(requestPath.substring(0, requestPath.lastIndexOf('/') + 1));
+                        }
+                        cookieExpiry.put(cookieKey(cookie), cookie.getMaxAge() < 0 ? -1 : System.currentTimeMillis() + cookie.getMaxAge() * 1000);
+                    }
+                }
