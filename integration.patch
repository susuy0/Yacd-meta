diff --git a/TMessagesProj/src/main/assets/futoon/futoon.css b/TMessagesProj/src/main/assets/futoon/futoon.css
new file mode 100644
index 0000000..b45efad
--- /dev/null
+++ b/TMessagesProj/src/main/assets/futoon/futoon.css
@@ -0,0 +1,254 @@
+/* FUTOON 悬浮面板 · 共用样式（原型用，模拟数据） */
+[data-theme]{font-family:"Noto Sans SC","PingFang SC","Microsoft YaHei",system-ui,sans-serif;font-size:14px;line-height:20px;color:var(--text);-webkit-font-smoothing:antialiased}
+[data-theme] *,[data-theme] *::before,[data-theme] *::after{box-sizing:border-box}
+[data-theme] button{font:inherit;color:inherit;margin:0;cursor:pointer;background:none;border:0;padding:0;text-align:inherit}
+[data-theme] input,[data-theme] textarea,[data-theme] select{font:inherit;color:inherit;margin:0}
+[data-theme] a{color:inherit;text-decoration:none}
+[data-theme] p,[data-theme] h1,[data-theme] h2,[data-theme] h3{margin:0}
+
+/* ---------- 主题变量 ---------- */
+[data-theme="light"]{
+  --bg:#EEF2EF;--surface:#FFFFFF;--surface-2:#F3F6F3;--surface-3:#E4EAE6;
+  --line:#D9E0DB;--line-strong:#7E8D84;
+  --text:#13201A;--text-2:#46564D;--text-3:#5B6A61;
+  --primary:#0B7A4B;--primary-press:#096540;--on-primary:#FFFFFF;--primary-soft:#DCF1E6;--primary-ink:#075A37;
+  --info:#1D5FBF;--info-soft:#E1EBFA;--warn:#8A5200;--warn-soft:#FBEACB;--danger:#B3261E;--danger-soft:#FBE2DF;--on-danger:#FFFFFF;
+  --target:#1D5FBF;--target-soft:#E1EBFA;
+  --scrim:rgba(8,20,14,.34);--shadow:0 -4px 28px rgba(8,30,18,.22);
+  --chat-bg:#D6E4DA;--chat-bar:#FFFFFF;--bubble-in:#FFFFFF;--bubble-out:#CBEBD6;
+}
+[data-theme="dark"]{
+  --bg:#0D1210;--surface:#171E1A;--surface-2:#202923;--surface-3:#2B352E;
+  --line:#303C34;--line-strong:#6B7C72;
+  --text:#E7EEE9;--text-2:#B4C1B8;--text-3:#93A39A;
+  --primary:#4FC48D;--primary-press:#6BD3A1;--on-primary:#04210F;--primary-soft:#1B3A2C;--primary-ink:#86E0B2;
+  --info:#8DBBF8;--info-soft:#1C2F4D;--warn:#F2B457;--warn-soft:#3B2D10;--danger:#FF9087;--danger-soft:#4B211D;--on-danger:#3A0A06;
+  --target:#8DBBF8;--target-soft:#1C2F4D;
+  --scrim:rgba(0,0,0,.5);--shadow:0 -4px 28px rgba(0,0,0,.6);
+  --chat-bg:#0F1A14;--chat-bar:#171E1A;--bubble-in:#1F2A24;--bubble-out:#244A36;
+}
+
+/* ---------- 图标与基础 ---------- */
+.ic{width:24px;height:24px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;flex:none}
+.ic-sm{width:18px;height:18px}.ic-xs{width:14px;height:14px}.ic-lg{width:28px;height:28px}
+@keyframes spin{to{transform:rotate(360deg)}}
+.spin{animation:spin 1s linear infinite}
+.mono{font-family:"IBM Plex Mono",ui-monospace,Menlo,monospace;font-feature-settings:"zero" 1,"tnum" 1}
+.b{font-weight:600}.c2{color:var(--text-2)}.c3{color:var(--text-3)}.cp{color:var(--primary-ink)}.cw{color:var(--warn)}.cd{color:var(--danger)}.ci{color:var(--info)}
+.t-title{font-size:18px;line-height:24px;font-weight:600}
+.t-sec{font-size:15px;line-height:22px;font-weight:600}
+.t-lab{font-size:12px;line-height:16px;font-weight:500}
+.t-cap{font-size:12px;line-height:16px}
+.t-13{font-size:13px;line-height:18px}
+.clamp1{overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
+.clamp2{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
+.rf{display:flex;align-items:center}.col{display:flex;flex-direction:column}
+.g4{gap:4px}.g6{gap:6px}.g8{gap:8px}.g10{gap:10px}.g12{gap:12px}.g16{gap:16px}.g24{gap:24px}
+.f1{flex:1;min-width:0}.nos{flex:none}.wrap{flex-wrap:wrap}.between{justify-content:space-between}.ctr{justify-content:center}.end{justify-content:flex-end}.top{align-items:flex-start}
+.hr{height:1px;background:var(--line);border:0;margin:0;flex:none}
+
+/* ---------- 手机画面与面板 ---------- */
+.phone{position:relative;width:390px;height:844px;overflow:hidden;background:var(--chat-bg)}
+.fill{position:absolute;inset:0}
+.scrim{position:absolute;inset:0;background:var(--scrim)}
+.panel{position:absolute;left:8px;right:8px;bottom:8px;background:var(--surface);border-radius:22px;box-shadow:var(--shadow);display:flex;flex-direction:column;overflow:hidden;border:1px solid var(--line)}
+.panel.compact{height:576px}.panel.large{height:756px}
+.grip-row{height:20px;display:flex;align-items:center;justify-content:center;flex:none;cursor:grab}
+.grip{width:36px;height:4px;border-radius:2px;background:var(--line-strong)}
+.hd{flex:none;padding:0 4px 8px 16px}
+.hd-top{display:flex;align-items:center;gap:4px;min-height:48px}
+.hd-chat{flex:1;min-width:0;display:flex;align-items:center;gap:8px;font-size:13px;line-height:18px;color:var(--text-2)}
+.hd-ctx{display:flex;flex-wrap:wrap;align-items:center;gap:6px 8px;padding-right:12px}
+.btn-icon{width:48px;height:48px;border-radius:24px;display:flex;align-items:center;justify-content:center;color:var(--text-2);flex:none}
+.btn-icon:active{background:var(--surface-3)}
+.btn-icon.on{background:var(--primary-soft);color:var(--primary-ink)}
+.body{flex:1;min-height:0;overflow-y:auto;padding:4px 16px 16px;display:flex;flex-direction:column;gap:12px}
+.body::-webkit-scrollbar{width:0;height:0}
+.actionbar{flex:none;padding:10px 16px;border-top:1px solid var(--line);background:var(--surface);display:flex;gap:10px;align-items:center}
+.tabbar{flex:none;display:flex;gap:2px;border-top:1px solid var(--line);background:var(--surface);padding:4px 6px 6px}
+.tab{flex:1;min-height:52px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;font-size:12px;line-height:16px;font-weight:500;color:var(--text-2);border-radius:14px}
+.tab.on{background:var(--primary-soft);color:var(--primary-ink);font-weight:700}
+.sub-hd{display:flex;align-items:center;gap:4px;min-height:48px;padding:0 12px 0 4px;flex:none}
+.sub-hd .t{flex:1;min-width:0;font-size:16px;line-height:22px;font-weight:600}
+
+/* ---------- 按钮 ---------- */
+.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;padding:0 18px;border-radius:14px;font-size:15px;line-height:20px;font-weight:600;border:1.5px solid transparent;white-space:nowrap;text-align:center}
+.btn.sm{min-height:40px;padding:0 14px;font-size:14px;border-radius:12px}
+.btn.block{flex:1;min-width:0}
+/* 视觉小于 48dp 的控件：用不可见的扩展区补足触摸区 */
+.chip,.btn.sm,.btn-copy{position:relative}
+.chip::after{content:"";position:absolute;left:0;right:0;top:-6px;bottom:-6px}
+.btn.sm::after{content:"";position:absolute;left:0;right:0;top:-4px;bottom:-4px}
+.btn-copy::after{content:"";position:absolute;inset:-4px}
+.btn-primary{background:var(--primary);color:var(--on-primary)}
+.btn-primary:active{background:var(--primary-press)}
+.btn-tonal{background:var(--primary-soft);color:var(--primary-ink)}
+.btn-outline{border-color:var(--line-strong);color:var(--text)}
+.btn-text{color:var(--primary-ink);padding:0 10px}
+.btn-danger{background:var(--danger);color:var(--on-danger)}
+.btn-danger-o{border-color:var(--danger);color:var(--danger)}
+.btn-target{background:var(--target);color:var(--surface)}
+.btn[disabled],.btn.dis{background:var(--surface-3);color:var(--text-3);border-color:transparent;cursor:not-allowed}
+.btn.busy{background:var(--surface-3);color:var(--text-2);cursor:progress}
+
+/* ---------- 标签 / 徽标 / 芯片 ---------- */
+.badge{display:inline-flex;align-items:center;gap:4px;height:24px;padding:0 8px;border-radius:12px;font-size:12px;line-height:16px;font-weight:600;white-space:nowrap;flex:none}
+.badge.ok{background:var(--primary-soft);color:var(--primary-ink)}
+.badge.warn{background:var(--warn-soft);color:var(--warn)}
+.badge.err{background:var(--danger-soft);color:var(--danger)}
+.badge.info{background:var(--info-soft);color:var(--info)}
+.badge.mute{background:var(--surface-3);color:var(--text-2)}
+.chip{display:inline-flex;align-items:center;gap:6px;min-height:36px;padding:0 14px;border-radius:18px;border:1.5px solid var(--line-strong);font-size:13px;line-height:18px;font-weight:500;color:var(--text);white-space:nowrap;background:var(--surface)}
+.chip.on{background:var(--primary-soft);border-color:var(--primary);color:var(--primary-ink);font-weight:600}
+.chip.tgt.on{background:var(--target-soft);border-color:var(--target);color:var(--target)}
+.pid{display:inline-flex;align-items:center;gap:6px;height:28px;padding:0 10px;border-radius:8px;background:var(--primary-soft);color:var(--primary-ink);font-size:13px;font-weight:700;white-space:nowrap;flex:none}
+.pid .l{font-size:12px;font-weight:500}
+.src{display:inline-flex;align-items:center;gap:4px;height:24px;padding:0 8px;border-radius:12px;border:1px solid var(--line-strong);font-size:12px;line-height:16px;color:var(--text-2);white-space:nowrap;flex:none}
+.tgt-chip{display:inline-flex;align-items:center;gap:6px;height:28px;padding:0 10px;border-radius:8px;background:var(--target-soft);color:var(--target);font-size:13px;font-weight:700}
+
+/* ---------- 卡片 / 键值 ---------- */
+.card{background:var(--surface-2);border:1px solid var(--line);border-radius:14px;padding:12px}
+.card.raised{background:var(--surface)}
+.card.sel{border:2px solid var(--primary);padding:11px}
+.card.warn{border-color:var(--warn);background:var(--warn-soft)}
+.card.err{border-color:var(--danger)}
+.kv{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;padding:5px 0}
+.kv .k{color:var(--text-2);font-size:13px;line-height:18px;flex:none;min-width:76px}
+.kv .v{min-width:0;text-align:right;font-weight:500;word-break:break-all}
+.kv .v.l{text-align:left}
+.idbox{display:flex;align-items:center;gap:4px;background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:2px 2px 2px 10px;min-height:40px}
+.idtxt{flex:1;min-width:0;overflow-x:auto;white-space:nowrap;font-size:13px;line-height:20px}
+.idtxt::-webkit-scrollbar{height:0}
+.btn-copy{width:40px;height:40px;border-radius:10px;display:flex;align-items:center;justify-content:center;color:var(--text-2);flex:none}
+.amt{font-family:"IBM Plex Mono",ui-monospace,monospace;font-feature-settings:"zero" 1,"tnum" 1;font-weight:600;font-size:16px;line-height:22px;white-space:nowrap}
+.amt.lg{font-size:24px;line-height:30px}
+.amt .cur{font-family:"Noto Sans SC",sans-serif;font-size:12px;line-height:16px;font-weight:600;color:var(--text-2);margin-left:4px;letter-spacing:.02em}
+.sec-h{display:flex;align-items:center;justify-content:space-between;font-size:13px;line-height:18px;font-weight:600;color:var(--text-2);padding-top:4px}
+.li{display:flex;align-items:center;gap:12px;min-height:56px;padding:8px 0;border-bottom:1px solid var(--line)}
+.li:last-child{border-bottom:0}
+.ico{width:40px;height:40px;border-radius:12px;background:var(--surface-3);display:flex;align-items:center;justify-content:center;color:var(--text-2);flex:none}
+.ico.p{background:var(--primary-soft);color:var(--primary-ink)}
+.ico.t{background:var(--target-soft);color:var(--target)}
+.ico.w{background:var(--warn-soft);color:var(--warn)}
+
+/* ---------- 表单 ---------- */
+.field{display:flex;flex-direction:column;gap:6px}
+.field>label,.lab{font-size:12px;line-height:16px;font-weight:600;color:var(--text-2)}
+.inp{width:100%;height:48px;border-radius:12px;border:1.5px solid var(--line-strong);background:var(--surface);padding:0 12px;font-size:15px}
+.inp:focus{outline:none;border-color:var(--primary);box-shadow:0 0 0 3px var(--primary-soft)}
+.inp.err{border-color:var(--danger)}
+.inp::placeholder{color:var(--text-3)}
+.ta{width:100%;min-height:92px;border-radius:12px;border:1.5px solid var(--line-strong);background:var(--surface);padding:10px 12px;font-size:14px;line-height:20px;resize:none}
+.ta:focus{outline:none;border-color:var(--primary);box-shadow:0 0 0 3px var(--primary-soft)}
+.help{font-size:12px;line-height:16px;color:var(--text-3)}
+.help.err{color:var(--danger)}
+.seg{display:flex;background:var(--surface-3);border-radius:14px;padding:3px;gap:3px}
+.seg button{flex:1;min-height:44px;border-radius:11px;font-weight:500;color:var(--text-2);display:flex;align-items:center;justify-content:center;gap:6px;text-align:center;padding:0 6px}
+.seg button.on{background:var(--surface);color:var(--text);font-weight:700;box-shadow:0 1px 3px rgba(0,0,0,.22)}
+.sw{width:52px;height:32px;border-radius:16px;background:var(--surface-3);border:2px solid var(--line-strong);position:relative;flex:none}
+.sw::after{content:"";position:absolute;top:3px;left:3px;width:22px;height:22px;border-radius:50%;background:var(--text-3)}
+.sw.on{background:var(--primary);border-color:var(--primary)}
+.sw.on::after{left:23px;background:var(--on-primary)}
+.radio{width:24px;height:24px;border-radius:50%;border:2px solid var(--line-strong);flex:none;display:flex;align-items:center;justify-content:center}
+.radio.on{border-color:var(--primary)}
+.radio.on::after{content:"";width:12px;height:12px;border-radius:50%;background:var(--primary)}
+.cbox{width:24px;height:24px;border-radius:7px;border:2px solid var(--line-strong);flex:none;display:flex;align-items:center;justify-content:center;color:var(--on-primary)}
+.cbox.on{background:var(--primary);border-color:var(--primary)}
+
+/* ---------- 提示 / 弹层 ---------- */
+.banner{display:flex;gap:10px;align-items:flex-start;padding:10px 12px;border-radius:12px;font-size:13px;line-height:18px;background:var(--surface-2);border:1px solid var(--line)}
+.banner .bt{font-weight:700}
+.banner.info{background:var(--info-soft);border-color:transparent}.banner.info>.ic{color:var(--info)}
+.banner.warn{background:var(--warn-soft);border-color:transparent}.banner.warn>.ic{color:var(--warn)}
+.banner.err{background:var(--danger-soft);border-color:transparent}.banner.err>.ic{color:var(--danger)}
+.banner.ok{background:var(--primary-soft);border-color:transparent}.banner.ok>.ic{color:var(--primary-ink)}
+.sheet-wrap{position:absolute;inset:0;background:var(--scrim);display:flex;flex-direction:column;justify-content:flex-end;z-index:5}
+.sheet{background:var(--surface);border-radius:20px 20px 0 0;padding:8px 16px 16px;display:flex;flex-direction:column;gap:12px;max-height:92%;overflow-y:auto}
+.sheet::-webkit-scrollbar{width:0}
+.dlg-wrap{position:absolute;inset:0;background:var(--scrim);display:flex;align-items:center;justify-content:center;padding:20px;z-index:9}
+.dlg{background:var(--surface);border-radius:20px;padding:20px;display:flex;flex-direction:column;gap:12px;width:100%;box-shadow:0 8px 30px rgba(0,0,0,.3)}
+.toast{position:absolute;left:16px;right:16px;bottom:96px;background:var(--text);color:var(--surface);padding:12px 14px;border-radius:12px;display:flex;gap:10px;align-items:center;z-index:8;font-size:13px;line-height:18px}
+.bar{height:6px;border-radius:3px;background:var(--surface-3);overflow:hidden}
+.bar>b{display:block;height:100%;background:var(--primary);border-radius:3px}
+
+/* ---------- 缩略图（示例截图占位） ---------- */
+.thumb{position:relative;width:84px;height:112px;border-radius:10px;background:var(--surface-3);border:1px solid var(--line);overflow:hidden;flex:none}
+.thumb .tb{position:absolute;left:8px;right:8px;top:10px;height:14px;border-radius:4px;background:var(--primary)}
+.thumb .tl{position:absolute;left:8px;height:6px;border-radius:3px;background:var(--line-strong)}
+.thumb .tx{position:absolute;left:8px;right:8px;bottom:8px;font-size:12px;line-height:14px;font-weight:600;color:var(--text-2)}
+.thumb.sel{outline:3px solid var(--primary);outline-offset:1px}
+.thumb .tbadge{position:absolute;right:4px;top:4px;width:22px;height:22px;border-radius:11px;display:flex;align-items:center;justify-content:center;background:var(--surface);color:var(--text)}
+
+/* ---------- 聊天背景（模拟 Telegram 风格，非官方素材） ---------- */
+.ch-hd{height:64px;display:flex;align-items:center;gap:10px;padding:0 10px 0 6px;background:var(--chat-bar);border-bottom:1px solid var(--line);position:relative;z-index:1}
+.ch-av{width:40px;height:40px;border-radius:20px;background:var(--primary-soft);color:var(--primary-ink);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:15px;flex:none}
+.ch-msgs{position:absolute;left:0;right:0;top:64px;bottom:60px;padding:14px 12px;display:flex;flex-direction:column;gap:8px;overflow:hidden}
+.bub{max-width:80%;padding:7px 12px 6px;border-radius:16px 16px 16px 6px;background:var(--bubble-in);font-size:14px;line-height:20px;align-self:flex-start;color:var(--text)}
+.bub.out{background:var(--bubble-out);align-self:flex-end;border-radius:16px 16px 6px 16px}
+.bub .who{font-size:12px;line-height:16px;font-weight:700;color:var(--primary-ink)}
+.bub .tm{font-size:12px;line-height:14px;color:var(--text-3);text-align:right;margin-top:2px}
+.bub .hl{background:var(--warn-soft);border-radius:4px;padding:0 2px}
+.ch-in{position:absolute;left:0;right:0;bottom:0;height:60px;background:var(--chat-bar);border-top:1px solid var(--line);display:flex;align-items:center;gap:6px;padding:0 6px}
+.ch-in .ph{flex:1;height:40px;border-radius:20px;background:var(--surface-2);display:flex;align-items:center;padding:0 14px;color:var(--text-3)}
+
+/* ---------- 浮球 ---------- */
+.ball{position:absolute;width:48px;height:48px;border-radius:24px;background:var(--primary);color:var(--on-primary);display:flex;align-items:center;justify-content:center;box-shadow:0 4px 14px rgba(0,0,0,.32);border:2px solid var(--surface);z-index:20;touch-action:none;cursor:grab}
+.ball .bd{position:absolute;right:-6px;top:-6px;width:22px;height:22px;border-radius:11px;background:var(--surface);color:var(--text);display:flex;align-items:center;justify-content:center;border:1.5px solid var(--line-strong)}
+.ball .bd.ok{color:var(--primary-ink)}.ball .bd.warn{color:var(--warn)}.ball .bd.err{color:var(--danger)}.ball .bd.info{color:var(--info)}
+.ball-lab{position:absolute;z-index:20;height:24px;padding:0 8px;border-radius:12px;background:var(--surface);color:var(--text);font-size:12px;line-height:22px;font-weight:600;border:1px solid var(--line-strong);white-space:nowrap;box-shadow:0 2px 8px rgba(0,0,0,.2)}
+
+/* ---------- 原型演示控制（非产品界面） ---------- */
+.rail{width:280px;flex:none;align-self:flex-start;display:flex;flex-direction:column;gap:12px;padding:16px;border:1.5px dashed var(--line-strong);border-radius:16px;background:var(--surface)}
+.rail .rt{font-size:12px;line-height:16px;font-weight:700;color:var(--text-2);letter-spacing:.04em}
+.rail .rb{display:flex;flex-wrap:wrap;gap:8px}
+.demo{display:flex;gap:20px;align-items:flex-start}
+
+/* ---------- 说明页版式 ---------- */
+.sp{box-sizing:border-box;width:1280px;background:var(--surface);color:var(--text);padding:56px 64px 64px;display:flex;flex-direction:column;gap:36px}
+.sp-h1{font-size:40px;line-height:48px;font-weight:700;letter-spacing:-.01em}
+.sp-h2{font-size:24px;line-height:32px;font-weight:700;display:flex;align-items:center;gap:12px}
+.sp-h2 .n{width:32px;height:32px;border-radius:10px;background:var(--primary);color:var(--on-primary);display:flex;align-items:center;justify-content:center;font-size:15px;font-weight:700;flex:none}
+.sp-h3{font-size:16px;line-height:24px;font-weight:700}
+.sp-p{font-size:15px;line-height:24px;color:var(--text-2)}
+.sp-grid{display:grid;gap:20px}
+.sp-card{background:var(--surface-2);border:1px solid var(--line);border-radius:16px;padding:20px;display:flex;flex-direction:column;gap:10px}
+.sp-card.hl{background:var(--primary-soft);border-color:transparent}
+.sp-card ul{margin:0;padding-left:20px;display:flex;flex-direction:column;gap:6px;font-size:14px;line-height:22px;color:var(--text)}
+.sp-tbl{width:100%;border-collapse:collapse;font-size:14px;line-height:20px}
+.sp-tbl th{text-align:left;font-size:12px;line-height:16px;letter-spacing:.04em;color:var(--text-2);font-weight:700;padding:10px 12px;border-bottom:2px solid var(--line-strong)}
+.sp-tbl td{padding:10px 12px;border-bottom:1px solid var(--line);vertical-align:top}
+.flow{display:flex;align-items:stretch;gap:0;flex-wrap:wrap;row-gap:12px}
+.flow .st{background:var(--surface);border:1.5px solid var(--line-strong);border-radius:12px;padding:10px 14px;font-size:14px;line-height:20px;font-weight:600;display:flex;align-items:center;gap:8px}
+.flow .st.p{background:var(--primary-soft);border-color:var(--primary)}
+.flow .st.t{background:var(--target-soft);border-color:var(--target)}
+.flow .ar{display:flex;align-items:center;padding:0 6px;color:var(--text-3)}
+.tile{min-height:72px;border-radius:14px;background:var(--surface-2);border:1px solid var(--line);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;font-size:13px;line-height:18px;font-weight:600;padding:8px 4px;text-align:center;color:var(--text)}
+.tile[disabled]{opacity:.62;cursor:not-allowed}
+.tile .ic{color:var(--primary-ink)}
+.tile.fund .ic{color:var(--warn)}
+.tile .sub{font-size:12px;line-height:16px;font-weight:400;color:var(--text-2)}
+.cell{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:8px 10px;min-width:0}
+.cell.hit{border:2px solid var(--primary);padding:7px 9px}
+.cell .cl{font-size:12px;line-height:16px;color:var(--text-2)}
+.cell.hit .cl{color:var(--primary-ink);font-weight:700}
+.ghost{border:1.5px dashed var(--line-strong);border-radius:14px}
+.swatch{height:56px;border-radius:12px;border:1px solid var(--line);display:flex;align-items:flex-end;padding:6px 8px;font-size:12px;line-height:14px;font-weight:600}
+
+/* ---------- 共用状态页 / 组件规范页 ---------- */
+.stc{display:grid;grid-template-columns:392px 1fr;gap:12px 28px;background:var(--surface-2);border:1px solid var(--line);border-radius:16px;padding:20px}
+.stc-h{grid-column:1 / span 2;display:flex;align-items:center;gap:10px}
+.stc-h .no{width:28px;height:28px;border-radius:8px;background:var(--surface-3);display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;flex:none}
+.pv{background:var(--bg);border:1px solid var(--line);border-radius:14px;padding:12px;display:flex;flex-direction:column;gap:8px;align-self:start}
+.pv-t{font-size:12px;line-height:16px;font-weight:700;color:var(--text-2);letter-spacing:.04em}
+.sk{height:12px;border-radius:6px;background:var(--surface-3)}
+.srow{display:grid;grid-template-columns:76px 1fr;gap:12px;padding:8px 0;border-top:1px solid var(--line);font-size:14px;line-height:20px}
+.srow:first-child{border-top:0;padding-top:0}
+.srow .k{font-size:13px;line-height:20px;font-weight:700;color:var(--text-2)}
+.srow.yes .k{color:var(--primary-ink)}
+.srow.no .k{color:var(--danger)}
+.srow ul{margin:0;padding-left:18px;display:flex;flex-direction:column;gap:2px}
+.cmp{background:var(--surface);color:var(--text);padding:20px;border-radius:16px;border:1px solid var(--line);display:flex;flex-direction:column;gap:12px}
+.cmp-t{font-size:12px;line-height:16px;font-weight:700;letter-spacing:.04em;color:var(--text-2)}
+.cmp-l{font-size:12px;line-height:16px;color:var(--text-3)}
+.dim{display:flex;align-items:center;gap:6px;font-size:12px;line-height:16px;color:var(--info);font-family:"IBM Plex Mono",ui-monospace,monospace}
+.dim i{display:block;height:0;border-top:1.5px solid var(--info);flex:1;position:relative}
