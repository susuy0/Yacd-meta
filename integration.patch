+import android.os.Bundle;
+import android.view.*;
+import android.widget.*;
+import java.io.*;
+import org.telegram.messenger.AndroidUtilities;
+
+/** Local, reversible receipt edits. Original evidence is never overwritten. */
+public final class FutoonImageEditor extends Dialog {
+    public interface Saved{void accept(File file);}
+    private final File original;private final Saved saved;private final Runnable cancelled;
+    private Bitmap bitmap;private Editor view;private String mode="frame",label="";private boolean committed;
+    public FutoonImageEditor(Activity activity,File file,Saved saved,Runnable cancelled){super(activity);original=file;this.saved=saved;this.cancelled=cancelled;}
+    @Override protected void onCreate(Bundle state){
+        super.onCreate(state);getWindow().setBackgroundDrawableResource(android.R.color.white);
+        LinearLayout root=new LinearLayout(getContext());root.setOrientation(LinearLayout.VERTICAL);root.setPadding(12,12,12,12);
+        TextView title=new TextView(getContext());title.setText("编辑凭证   拖动框选区域");title.setTextSize(18);title.setPadding(12,12,12,12);root.addView(title);
+        try{load();}catch(Exception e){dismiss();cancelled.run();return;}
+        view=new Editor();root.addView(view,new LinearLayout.LayoutParams(-1,0,1));
+        LinearLayout tools=new LinearLayout(getContext());HorizontalScrollView sc=new HorizontalScrollView(getContext());sc.addView(tools);root.addView(sc);
+        button(tools,"画框",()->mode="frame");button(tools,"打码",()->mode="redact");button(tools,"裁剪",()->mode="crop");
+        button(tools,"文字",()->{
+            EditText text=new EditText(getContext());text.setHint("输入标注文字");
+            new android.app.AlertDialog.Builder(getContext()).setTitle("文字标注").setView(text).setPositiveButton("确定",(d,w)->{label=text.getText().toString();mode="text";}).setNegativeButton("取消",null).show();
+        });
+        button(tools,"旋转",()->{Matrix m=new Matrix();m.postRotate(90);Bitmap next=Bitmap.createBitmap(bitmap,0,0,bitmap.getWidth(),bitmap.getHeight(),m,true);if(next!=bitmap)bitmap.recycle();bitmap=next;view.invalidate();});
+        button(tools,"重置",()->{try{bitmap.recycle();load();view.invalidate();}catch(Exception ignored){}});
+        LinearLayout actions=new LinearLayout(getContext());root.addView(actions);
+        button(actions,"取消",this::cancel);button(actions,"保存副本",()->{
+            try{
+                File dir=new File(getContext().getCacheDir(),"futoon-evidence");if(!dir.exists())dir.mkdirs();
+                File file=File.createTempFile("edited-",".jpg",dir);
+                try(OutputStream out=new FileOutputStream(file)){if(!bitmap.compress(Bitmap.CompressFormat.JPEG,95,out))throw new IOException("保存失败");}
+                committed=true;saved.accept(file);dismiss();
+            }catch(Exception e){Toast.makeText(getContext(),"保存失败："+e.getMessage(),Toast.LENGTH_LONG).show();}
+        });
+        setContentView(root);getWindow().setLayout(-1,-1);setOnDismissListener(d->{if(bitmap!=null&&!bitmap.isRecycled())bitmap.recycle();if(!committed)cancelled.run();});
+    }
+    private void load()throws IOException{
+        BitmapFactory.Options o=new BitmapFactory.Options();o.inJustDecodeBounds=true;BitmapFactory.decodeFile(original.getPath(),o);
+        o.inSampleSize=1;while(Math.max(o.outWidth,o.outHeight)/o.inSampleSize>2800)o.inSampleSize*=2;
+        o.inJustDecodeBounds=false;o.inMutable=true;o.inPreferredConfig=Bitmap.Config.ARGB_8888;
+        bitmap=BitmapFactory.decodeFile(original.getPath(),o);if(bitmap==null)throw new IOException("图片不可读");
+    }
+    private void button(LinearLayout group,String text,Runnable action){Button b=new Button(getContext());b.setText(text);b.setMinHeight(AndroidUtilities.dp(48));b.setOnClickListener(v->action.run());group.addView(b,new LinearLayout.LayoutParams(-2,-2));}
+    private final class Editor extends View{
+        final Paint paint=new Paint(3);final RectF shown=new RectF();float x0,y0,x1,y1;boolean dragging;
+        Editor(){super(FutoonImageEditor.this.getContext());setBackgroundColor(0xff202923);}
+        @Override protected void onDraw(Canvas c){
+            super.onDraw(c);if(bitmap==null||bitmap.isRecycled())return;
+            float scale=Math.min(getWidth()/(float)bitmap.getWidth(),getHeight()/(float)bitmap.getHeight());
+            float w=bitmap.getWidth()*scale,h=bitmap.getHeight()*scale;
+            shown.set((getWidth()-w)/2,(getHeight()-h)/2,(getWidth()+w)/2,(getHeight()+h)/2);
+            c.drawBitmap(bitmap,null,shown,paint);
+            if(dragging){paint.setStyle(Paint.Style.STROKE);paint.setColor(Color.RED);paint.setStrokeWidth(3);c.drawRect(Math.min(x0,x1),Math.min(y0,y1),Math.max(x0,x1),Math.max(y0,y1),paint);paint.setStyle(Paint.Style.FILL);}
+        }
+        @Override public boolean onTouchEvent(MotionEvent e){
+            if(e.getAction()==MotionEvent.ACTION_DOWN){x0=x1=e.getX();y0=y1=e.getY();dragging=true;invalidate();return true;}
+            if(e.getAction()==MotionEvent.ACTION_MOVE){x1=e.getX();y1=e.getY();invalidate();return true;}
+            if(e.getAction()==MotionEvent.ACTION_UP){
+                dragging=false;x1=e.getX();y1=e.getY();
+                float sx=bitmap.getWidth()/shown.width(),sy=bitmap.getHeight()/shown.height();
+                int l=Math.max(0,(int)((Math.min(x0,x1)-shown.left)*sx)),t=Math.max(0,(int)((Math.min(y0,y1)-shown.top)*sy));
+                int r=Math.min(bitmap.getWidth(),(int)((Math.max(x0,x1)-shown.left)*sx)),b=Math.min(bitmap.getHeight(),(int)((Math.max(y0,y1)-shown.top)*sy));
+                if(mode.equals("text")&&!label.isEmpty()){
+                    Canvas c=new Canvas(bitmap);paint.setColor(Color.RED);paint.setStyle(Paint.Style.FILL);paint.setTextSize(Math.max(24,bitmap.getWidth()/24f));c.drawText(label,l,Math.min(bitmap.getHeight()-4,t+paint.getTextSize()),paint);
+                }else if(r-l>3&&b-t>3){
+                    Rect region=new Rect(l,t,r,b);
+                    if(mode.equals("crop")){Bitmap next=Bitmap.createBitmap(bitmap,l,t,r-l,b-t);if(next!=bitmap)bitmap.recycle();bitmap=next;}
+                    else {Canvas c=new Canvas(bitmap);paint.setColor(mode.equals("redact")?Color.BLACK:Color.RED);paint.setStyle(mode.equals("redact")?Paint.Style.FILL:Paint.Style.STROKE);paint.setStrokeWidth(Math.max(3,bitmap.getWidth()/220f));c.drawRect(region,paint);paint.setStyle(Paint.Style.FILL);}
+                }
+                invalidate();return true;
+            }return true;
+        }
+    }
+}
