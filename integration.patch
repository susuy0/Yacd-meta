+import org.telegram.ui.Components.BackupImageView;
+import org.telegram.ui.Components.LayoutHelper;
+
+/** One-to-one contact page laid out like the reference "Contact Info" screen. */
+public final class FutoonContactInfoActivity extends BaseFragment implements NotificationCenter.NotificationCenterDelegate {
+    private final long userId;
+    private final Bundle originalArgs;
+    private LinearLayout content;
+    private TLRPC.UserFull userFull;
+    private boolean blocked;
+
+    private FutoonContactInfoActivity(Bundle args) {
+        super(args);
+        originalArgs = args;
+        userId = args.getLong("user_id", 0);
+    }
+
+    /** Swaps Telegram's profile for this page when a plain contact is opened; anything else keeps the original. */
+    public static BaseFragment replace(BaseFragment fragment) {
+        if (!BuildVars.FUTOON_LITE || !(fragment instanceof ProfileActivity)) {
+            return fragment;
+        }
+        Bundle a = fragment.getArguments();
+        if (a == null) {
+            return fragment;
+        }
+        long uid = a.getLong("user_id", 0);
+        if (uid == 0 || a.getLong("chat_id", 0) != 0 || a.getLong("topic_id", 0) != 0 || a.getBoolean("saved", false)
+            || a.getBoolean("my_profile", false) || a.getBoolean("futoon_original", false) || a.getBoolean("open_gifts", false)
+            || a.getBoolean("reportSpam", false) || a.getLong("ban_chat_id", 0) != 0 || a.getString("vcard_phone") != null
+            || a.getBoolean("similar", false)) {
+            return fragment;
+        }
+        TLRPC.User user = MessagesController.getInstance(UserConfig.selectedAccount).getUser(uid);
+        if (user == null || user.bot || UserObject.isUserSelf(user)) {
+            return fragment;
+        }
+        return new FutoonContactInfoActivity(a);
+    }
+
+    private boolean zh() {
+        return "zh".equals(LocaleController.getInstance().getCurrentLocale().getLanguage());
+    }
+
+    private String text(String en, String zhText) {
+        return zh() ? zhText : en;
+    }
+
+    @Override
+    public boolean onFragmentCreate() {
+        getNotificationCenter().addObserver(this, NotificationCenter.userInfoDidLoad);
+        TLRPC.User user = getMessagesController().getUser(userId);
+        userFull = getMessagesController().getUserFull(userId);
+        if (userFull != null) {
+            blocked = userFull.blocked;
+        }
+        if (user != null) {
+            getMessagesController().loadFullUser(user, classGuid, true);
+        }
+        return super.onFragmentCreate();
+    }
+
+    @Override
+    public void onFragmentDestroy() {
+        getNotificationCenter().removeObserver(this, NotificationCenter.userInfoDidLoad);
+        super.onFragmentDestroy();
+    }
+
+    @Override
+    public void didReceivedNotification(int id, int account, Object... args) {
+        if (id == NotificationCenter.userInfoDidLoad && args.length > 1 && args[0] instanceof Long && (Long) args[0] == userId && args[1] instanceof TLRPC.UserFull) {
+            userFull = (TLRPC.UserFull) args[1];
+            blocked = userFull.blocked;
+            if (content != null) {
+                rebuild(content.getContext());
+            }
+        }
+    }
+
+    @Override
+    public View createView(Context context) {
+        final boolean dark = FutoonChatAppearance.dark();
+        final int page = pageColor(dark);
+        actionBar.setBackButtonImage(R.drawable.ic_ab_back);
+        actionBar.setAllowOverlayTitle(true);
+        actionBar.setTitle(text("Contact Info", "联系人信息"));
+        actionBar.centerTitle();
+        actionBar.setBackgroundColor(page);
+        actionBar.setTitleColor(ChatLook.text(dark));
+        if (actionBar.getTitleTextView() != null) {
+            actionBar.getTitleTextView().setTextSize(17);
+            actionBar.getTitleTextView().setTypeface(AndroidUtilities.bold());
+        }
+        actionBar.setItemsColor(ChatLook.text(dark), false);
+        actionBar.setCastShadows(false);
+        actionBar.setActionBarMenuOnItemClick(new ActionBar.ActionBarMenuOnItemClick() {
+            @Override
+            public void onItemClick(int id) {
+                if (id == -1) {
+                    finishFragment();
+                }
+            }
+        });
+        ScrollView scroll = new ScrollView(context);
+        scroll.setBackgroundColor(page);
+        scroll.setVerticalScrollBarEnabled(false);
+        content = new LinearLayout(context);
+        content.setOrientation(LinearLayout.VERTICAL);
+        scroll.addView(content, new ScrollView.LayoutParams(ScrollView.LayoutParams.MATCH_PARENT, ScrollView.LayoutParams.WRAP_CONTENT));
+        fragmentView = scroll;
+        rebuild(context);
+        return fragmentView;
+    }
+
+    private static int pageColor(boolean dark) {
+        return dark ? 0xff0b0f10 : 0xfff6f6f6;
+    }
+
+    private void rebuild(Context context) {
+        if (content == null) {
+            return;
+        }
+        final boolean dark = FutoonChatAppearance.dark();
+        final int cardColor = ChatLook.incoming(dark);
+        final TLRPC.User user = getMessagesController().getUser(userId);
+        content.removeAllViews();
+        if (user == null) {
+            return;
+        }
+
+        BackupImageView avatar = new BackupImageView(context);
+        avatar.setRoundRadius(dp(50));
+        AvatarDrawable avatarDrawable = new AvatarDrawable(user);
+        avatar.setForUserOrChat(user, avatarDrawable);
+        LinearLayout.LayoutParams avatarParams = new LinearLayout.LayoutParams(dp(100), dp(100));
+        avatarParams.gravity = Gravity.CENTER_HORIZONTAL;
+        avatarParams.topMargin = dp(16);
+        content.addView(avatar, avatarParams);
+
+        TextView name = new TextView(context);
+        name.setText(UserObject.getUserName(user));
+        name.setTextSize(TypedValue.COMPLEX_UNIT_SP, 22);
+        name.setTypeface(AndroidUtilities.bold());
+        name.setTextColor(ChatLook.text(dark));
+        name.setGravity(Gravity.CENTER);
+        name.setSingleLine(true);
+        name.setEllipsize(android.text.TextUtils.TruncateAt.END);
+        LinearLayout.LayoutParams nameParams = new LinearLayout.LayoutParams(-1, -2);
+        nameParams.topMargin = dp(10);
+        nameParams.leftMargin = nameParams.rightMargin = dp(24);
+        content.addView(name, nameParams);
+
+        String subtitle;
+        if (user.phone != null && user.phone.length() > 0) {
+            subtitle = PhoneFormat.getInstance().format("+" + user.phone);
+        } else if (user.username != null && user.username.length() > 0) {
+            subtitle = "@" + user.username;
+        } else {
+            subtitle = LocaleController.formatUserStatus(currentAccount, user);
+        }
+        TextView sub = new TextView(context);
+        sub.setText(subtitle);
+        sub.setTextSize(TypedValue.COMPLEX_UNIT_SP, 15);
+        sub.setTextColor(ChatLook.secondary(dark));
+        sub.setGravity(Gravity.CENTER);
+        LinearLayout.LayoutParams subParams = new LinearLayout.LayoutParams(-1, -2);
+        subParams.topMargin = dp(2);
+        content.addView(sub, subParams);
+
+        // Action cards.
+        LinearLayout cards = new LinearLayout(context);
+        cards.setOrientation(LinearLayout.HORIZONTAL);
+        cards.addView(actionCard(context, "search", text("Search", "搜索"), cardColor, dark, v -> searchInChat()), cardParams());
+        final boolean muted = getMessagesController().isDialogMuted(userId, 0);
+        cards.addView(actionCard(context, "bell", muted ? text("Unmute", "取消静音") : text("Mute", "静音"), cardColor, dark, v -> toggleMute()), cardParams());
+        LinearLayout.LayoutParams cardsParams = new LinearLayout.LayoutParams(-1, -2);
+        cardsParams.topMargin = dp(16);
+        cardsParams.leftMargin = cardsParams.rightMargin = dp(12);
+        content.addView(cards, cardsParams);
+
+        // About.
+        if (userFull != null && userFull.about != null && userFull.about.length() > 0) {
+            TextView about = new TextView(context);
+            about.setText(userFull.about);
+            about.setTextSize(TypedValue.COMPLEX_UNIT_SP, 16);
+            about.setTextColor(ChatLook.text(dark));
+            about.setPadding(dp(16), dp(12), dp(16), dp(12));
+            about.setBackground(Theme.createRoundRectDrawable(dp(12), cardColor));
+            LinearLayout.LayoutParams aboutParams = new LinearLayout.LayoutParams(-1, -2);
+            aboutParams.topMargin = dp(16);
+            aboutParams.leftMargin = aboutParams.rightMargin = dp(16);
+            content.addView(about, aboutParams);
+        }
+
+        // Shared content and notifications.
+        content.addView(card(context, cardColor, dark,
+            row(context, "gallery", text("Media, Links and Docs", "媒体、链接和文档"), null, false, true, dark, v -> openMedia()),
+            row(context, "bell", text("Notifications", "通知"), muted ? text("Muted", "已静音") : text("On", "开启"), false, true, dark, v -> toggleMute())
+        ), groupParams(16));
+
+        // Destructive actions.
+        content.addView(card(context, cardColor, dark,
+            row(context, "delete", text("Clear Chat", "清空聊天记录"), null, true, false, dark, v -> confirmClear()),
+            row(context, "block", blocked ? text("Unblock ", "解除屏蔽 ") + UserObject.getUserName(user) : text("Block ", "屏蔽 ") + UserObject.getUserName(user), null, true, false, dark, v -> confirmBlock(user))
+        ), groupParams(16));
+
+        View bottom = new View(context);
+        content.addView(bottom, new LinearLayout.LayoutParams(-1, dp(32)));
+    }
+
+    private LinearLayout.LayoutParams cardParams() {
+        LinearLayout.LayoutParams p = new LinearLayout.LayoutParams(0, dp(64), 1f);
+        p.leftMargin = p.rightMargin = dp(4);
+        return p;
+    }
+
+    private LinearLayout.LayoutParams groupParams(int topDp) {
+        LinearLayout.LayoutParams p = new LinearLayout.LayoutParams(-1, -2);
+        p.topMargin = dp(topDp);
+        p.leftMargin = p.rightMargin = dp(16);
+        return p;
+    }
+
+    private View actionCard(Context context, String glyph, String label, int cardColor, boolean dark, View.OnClickListener listener) {
+        LinearLayout card = new LinearLayout(context);
+        card.setOrientation(LinearLayout.VERTICAL);
+        card.setGravity(Gravity.CENTER);
+        card.setBackground(Theme.createRoundRectDrawable(dp(12), cardColor));
+        ImageView icon = new ImageView(context);
+        icon.setImageDrawable(ChatLook.icon(glyph, ChatLook.accent(dark), AndroidUtilities.density));
+        card.addView(icon, new LinearLayout.LayoutParams(dp(24), dp(24)));
+        TextView text = new TextView(context);
+        text.setText(label);
+        text.setTextSize(TypedValue.COMPLEX_UNIT_SP, 12);
+        text.setTextColor(ChatLook.accent(dark));
+        text.setGravity(Gravity.CENTER);
+        LinearLayout.LayoutParams tp = new LinearLayout.LayoutParams(-2, -2);
+        tp.topMargin = dp(4);
+        card.addView(text, tp);
+        card.setOnClickListener(listener);
+        return card;
+    }
+
+    private View card(Context context, int cardColor, boolean dark, View... rows) {
+        LinearLayout card = new LinearLayout(context);
+        card.setOrientation(LinearLayout.VERTICAL);
+        card.setBackground(Theme.createRoundRectDrawable(dp(12), cardColor));
+        for (int i = 0; i < rows.length; i++) {
+            if (i > 0) {
+                View divider = new View(context);
+                divider.setBackgroundColor(ChatLook.tabBorder(dark));
+                LinearLayout.LayoutParams dividerParams = new LinearLayout.LayoutParams(-1, 1);
+                dividerParams.leftMargin = dp(52);
+                card.addView(divider, dividerParams);
+            }
+            card.addView(rows[i], new LinearLayout.LayoutParams(-1, dp(45)));
+        }
+        return card;
+    }
+
+    private View row(Context context, String glyph, String title, String value, boolean red, boolean chevron, boolean dark, View.OnClickListener listener) {
+        final int color = red ? 0xffe5333f : ChatLook.text(dark);
+        LinearLayout row = new LinearLayout(context);
+        row.setOrientation(LinearLayout.HORIZONTAL);
+        row.setGravity(Gravity.CENTER_VERTICAL);
+        row.setPadding(dp(16), 0, dp(14), 0);
+        row.setBackground(Theme.createSelectorDrawable(Theme.getColor(Theme.key_listSelector)));
+        ImageView icon = new ImageView(context);
+        icon.setImageDrawable(ChatLook.icon(glyph, color, AndroidUtilities.density));
+        LinearLayout.LayoutParams ip = new LinearLayout.LayoutParams(dp(22), dp(22));
+        ip.rightMargin = dp(14);
+        row.addView(icon, ip);
+        TextView label = new TextView(context);
+        label.setText(title);
+        label.setTextSize(TypedValue.COMPLEX_UNIT_SP, 16);
+        label.setTextColor(color);
+        label.setSingleLine(true);
+        label.setEllipsize(android.text.TextUtils.TruncateAt.END);
+        row.addView(label, new LinearLayout.LayoutParams(0, -2, 1f));
+        if (value != null) {
+            TextView detail = new TextView(context);
+            detail.setText(value);
+            detail.setTextSize(TypedValue.COMPLEX_UNIT_SP, 15);
+            detail.setTextColor(ChatLook.secondary(dark));
+            row.addView(detail, new LinearLayout.LayoutParams(-2, -2));
+        }
+        if (chevron) {
+            ImageView arrow = new ImageView(context);
+            arrow.setImageDrawable(ChatLook.icon("back", ChatLook.secondary(dark), AndroidUtilities.density));
+            arrow.setRotation(180);
+            LinearLayout.LayoutParams ap = new LinearLayout.LayoutParams(dp(16), dp(16));
+            ap.leftMargin = dp(8);
+            row.addView(arrow, ap);
+        }
+        row.setOnClickListener(listener);
+        return row;
+    }
+
+    private void openMedia() {
+        Bundle b = new Bundle(originalArgs);
+        b.putBoolean("futoon_original", true);
+        presentFragment(new ProfileActivity(b));
+    }
+
+    private void toggleMute() {
+        boolean muted = getMessagesController().isDialogMuted(userId, 0);
+        NotificationsController.getInstance(currentAccount).muteDialog(userId, 0, !muted);
+        AndroidUtilities.runOnUIThread(() -> {
+            if (content != null) {
+                rebuild(content.getContext());
+            }
+        }, 200);
+    }
+
+    private void searchInChat() {
+        ChatActivity existing = null;
+        if (parentLayout != null) {
+            for (BaseFragment f : parentLayout.getFragmentStack()) {
+                if (f instanceof ChatActivity && ((ChatActivity) f).getDialogId() == userId) {
+                    existing = (ChatActivity) f;
+                }
+            }
+        }
+        if (existing != null) {
+            final ChatActivity chat = existing;
+            finishFragment();
+            AndroidUtilities.runOnUIThread(() -> chat.openSearchWithText(""), 350);
+        } else {
+            Bundle args = new Bundle();
+            args.putLong("user_id", userId);
+            final ChatActivity chat = new ChatActivity(args);
+            presentFragment(chat);
+            AndroidUtilities.runOnUIThread(() -> chat.openSearchWithText(""), 600);
+        }
+    }
+
+    private void confirmClear() {
+        if (getParentActivity() == null) {
+            return;
+        }
+        AlertDialog.Builder builder = new AlertDialog.Builder(getParentActivity());
+        builder.setTitle(text("Clear Chat", "清空聊天记录"));
+        builder.setMessage(text("Delete all messages in this chat on this device?", "确定清空此聊天的全部消息吗？"));
+        builder.setPositiveButton(text("Clear", "清空"), (dialog, which) -> {
+            getMessagesController().deleteDialog(userId, 1);
+            finishFragment();
+        });
+        builder.setNegativeButton(LocaleController.getString(R.string.Cancel), null);
+        showDialog(builder.create());
+    }
+
+    private void confirmBlock(TLRPC.User user) {
+        if (getParentActivity() == null) {
+            return;
+        }
+        final boolean unblock = blocked;
+        AlertDialog.Builder builder = new AlertDialog.Builder(getParentActivity());
+        builder.setTitle((unblock ? text("Unblock ", "解除屏蔽 ") : text("Block ", "屏蔽 ")) + UserObject.getUserName(user));
+        builder.setMessage(unblock ? text("They will be able to message you again.", "对方将可以再次给你发消息。") : text("Blocked contacts cannot message you.", "被屏蔽的联系人无法给你发消息。"));
+        builder.setPositiveButton(unblock ? text("Unblock", "解除屏蔽") : text("Block", "屏蔽"), (dialog, which) -> {
+            if (unblock) {
+                getMessagesController().unblockPeer(userId);
+            } else {
+                getMessagesController().blockPeer(userId);
+            }
+            blocked = !unblock;
+            if (content != null) {
+                rebuild(content.getContext());
+            }
+        });
+        builder.setNegativeButton(LocaleController.getString(R.string.Cancel), null);
+        showDialog(builder.create());
+    }
+}
