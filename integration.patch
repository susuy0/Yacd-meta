diff --git a/TMessagesProj/src/main/java/org/telegram/ui/FutoonChatSettingsActivity.java b/TMessagesProj/src/main/java/org/telegram/ui/FutoonChatSettingsActivity.java
new file mode 100644
index 0000000000000000000000000000000000000000..5f8db5f3aa4f106393cf42d095023a2957a25e00
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/ui/FutoonChatSettingsActivity.java
@@ -0,0 +1,71 @@
+package org.telegram.ui;
+
+import android.content.Context;
+import android.view.View;
+import com.futoonpay.admin.ChatToolsHostBridge;
+import com.futoonpay.admin.ChatToolsView;
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.UserConfig;
+import org.telegram.messenger.R;
+import org.telegram.messenger.futoon.FutoonChatPreferences;
+import org.telegram.ui.ActionBar.ActionBar;
+import org.telegram.ui.ActionBar.BaseFragment;
+import android.content.Intent;
+
+/** Native custom settings, scoped to the selected Telegram account. */
+public final class FutoonChatSettingsActivity extends BaseFragment {
+    private ChatToolsView tools;
+    private final boolean replies;
+    private String selectedTab = "", selectedCategory = "";
+    private Runnable returnToPicker;
+    private FutoonSettingsHostActions actions;
+    public FutoonChatSettingsActivity(int account) { this(account, false); }
+    public FutoonChatSettingsActivity(int account, boolean replies) { currentAccount = account; this.replies = replies; }
+    public FutoonChatSettingsActivity(int account, String tab, String category, Runnable onReturn) { this(account, true); selectedTab = tab; selectedCategory = category; returnToPicker = onReturn; }
+    public String selectedTab() { return selectedTab; }
+    public String selectedCategory() { return selectedCategory; }
+    @Override public View createView(Context context) {
+        actionBar.setBackButtonImage(R.drawable.ic_ab_back);
+        actionBar.setTitle("FutoonPay 设置");
+        actionBar.setAllowOverlayTitle(true);
+        actionBar.setActionBarMenuOnItemClick(new ActionBar.ActionBarMenuOnItemClick() { @Override public void onItemClick(int id) { if (id == -1 && tools != null) tools.handleBack(); } });
+        FutoonChatPreferences preferences = FutoonChatPreferences.get(currentAccount);
+        actions = new FutoonSettingsHostActions(this, currentAccount, () -> { if (tools != null) tools.reloadSettings(); });
+        tools = new ChatToolsView(context, new com.futoonpay.admin.ChannelChatToolsHostBridge() {
+            public String channelAccountScope() { return currentAccount+":"+UserConfig.getInstance(currentAccount).getClientUserId(); }
+            public String channelBackendAddress() { return new org.telegram.messenger.futoon.FutoonStore(currentAccount).address(); }
+            public String load() { return preferences.raw(); }
+            public void save(String json) throws Exception { preferences.save(currentAccount, json); AndroidUtilities.runOnUIThread(() -> { if (tools != null) FutoonThemeBridge.refresh(tools); }); }
+            public String accountLabel() { return "当前 Telegram 账号 · ID " + UserConfig.getInstance(currentAccount).getClientUserId(); }
+            public String selectedTab() { return selectedTab; }
+            public String selectedCategory() { return selectedCategory; }
+            public void rememberSelection(String tab, String category) { selectedTab = tab; selectedCategory = category; }
+            public void manageAt(String tab, String category) {}
+            public void selectReply(String text) {}
+            public void manage() {}
+            public void originalSendOptions() {}
+            public void close() { finishFragment(); }
+            public void settingsTitle(String title) { actionBar.setTitle(title); }
+            public void pickEntryImage() { actions.chooseEntryImage(); }
+            public void pickAutomationGroup() { actions.chooseGroup(); }
+            public String selectedGroup() { return actions.selectedGroup(); }
+            public String automationLog() { return actions.automationLog(); }
+            public void resetEntryPosition() { actions.resetEntryPosition(); }
+        }, false, replies ? "replies" : "home");
+        FutoonThemeBridge.bind(tools, tools::setThemeColors, currentAccount);
+        fragmentView = tools; return fragmentView;
+    }
+    @Override public void onActivityResultFragment(int requestCode, int resultCode, Intent data) {
+        super.onActivityResultFragment(requestCode, resultCode, data);
+        if (actions != null) actions.activityResult(requestCode, resultCode, data);
+    }
+    @Override public void onResume() { super.onResume(); if (tools != null) { tools.onShown(); FutoonThemeBridge.refresh(tools); } }
+    @Override public boolean onBackPressed(boolean invoked) { if (tools != null) { if (invoked) tools.handleBack(); return false; } return super.onBackPressed(invoked); }
+    @Override public void onPause() { if (tools != null) tools.onHidden(); super.onPause(); }
+    @Override public void onFragmentDestroy() {
+        if (tools != null) { tools.close(); tools = null; }
+        super.onFragmentDestroy();
+        Runnable callback = returnToPicker; returnToPicker = null;
+        if (callback != null) AndroidUtilities.runOnUIThread(callback, 200);
+    }
+}
