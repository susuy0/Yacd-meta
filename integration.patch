+#!/usr/bin/env bash
+set -euo pipefail
+project_root="$(cd "$(dirname "$0")/../.." && pwd)"
+test_dir="$project_root/build/futoon-core-tests"
+mkdir -p "$test_dir/classes"
+json_jar="$test_dir/json-20240303.jar"
+if [ ! -f "$json_jar" ]; then
+    curl -fLsS 'https://repo.maven.apache.org/maven2/org/json/json/20240303/json-20240303.jar' -o "$json_jar"
+fi
+python3 - "$json_jar" <<'PY'
+import hashlib, sys
+from pathlib import Path
+actual = hashlib.sha256(Path(sys.argv[1]).read_bytes()).hexdigest()
+expected = '3cf6cd6892e32e2b4c1c39e0f52f5248a2f5b37646fdfbb79a66b46b618414ed'
+if actual != expected:
+    raise SystemExit('org.json dependency checksum mismatch')
+PY
+jsoup_jar="$test_dir/jsoup-1.19.1.jar"
+if [ ! -f "$jsoup_jar" ]; then
+    curl -fLsS 'https://repo.maven.apache.org/maven2/org/jsoup/jsoup/1.19.1/jsoup-1.19.1.jar' -o "$jsoup_jar"
+fi
+python3 - "$jsoup_jar" <<'PY'
+import hashlib, sys
+from pathlib import Path
+if hashlib.sha256(Path(sys.argv[1]).read_bytes()).hexdigest() != '7b850eb00f2f77f606a343b2e4effe4107f3c1faa183729d85fbe16baf606096':
+    raise SystemExit('jsoup dependency checksum mismatch')
+PY
+javac -cp "$json_jar:$jsoup_jar" -d "$test_dir/classes" \
+    "$project_root/TMessagesProj/src/main/java/org/telegram/messenger/futoon/FutoonQuery.java" \
+    "$project_root/TMessagesProj/src/main/java/org/telegram/messenger/futoon/FutoonIdentity.java" \
+    "$project_root/TMessagesProj/src/main/java/org/telegram/messenger/futoon/FutoonApi.java" \
+    "$project_root/TMessagesProj/src/main/java/org/telegram/messenger/futoon/FutoonBusinessApi.java" \
+    "$project_root/TMessagesProj/src/main/java/org/telegram/messenger/futoon/FutoonPanelLayout.java" \
+    "$project_root/Tools/futoon/FutoonPanelLayoutTest.java" \
+    "$project_root/Tools/futoon/FutoonCoreTest.java" "$project_root/Tools/futoon/FutoonExtendedTest.java" "$project_root/Tools/futoon/FutoonModuleTest.java"
+java -cp "$test_dir/classes:$json_jar:$jsoup_jar" org.telegram.messenger.futoon.FutoonCoreTest
+java -cp "$test_dir/classes:$json_jar:$jsoup_jar" org.telegram.messenger.futoon.FutoonExtendedTest
+java -cp "$test_dir/classes:$json_jar:$jsoup_jar" org.telegram.messenger.futoon.FutoonModuleTest
+java -cp "$test_dir/classes:$json_jar:$jsoup_jar" org.telegram.messenger.futoon.FutoonPanelLayoutTest
