+            while((n=in.read(buf))!=-1){total+=n;if(total>25*1024*1024)throw new IOException("图片超过 25 MB");out.write(buf,0,n);}
+            BitmapFactory.Options o=new BitmapFactory.Options();o.inJustDecodeBounds=true;BitmapFactory.decodeFile(f.getPath(),o);
+            if(o.outWidth<=0||o.outHeight<=0)throw new IOException("所选文件不是可读取的图片");ok=true;return f;
+        }finally{if(!ok)f.delete();}
+    }
+    private void ocr(String rid,File file){
+        try {
+            com.google.mlkit.vision.text.TextRecognizer recognizer=TextRecognition.getClient(new ChineseTextRecognizerOptions.Builder().build());
+            recognizer.process(InputImage.fromFilePath(root.getContext(),Uri.fromFile(file))).addOnSuccessListener(text->{
+                try{
+                    String raw=text.getText(),qr=decodeQr(file);
+                    if(!qr.isEmpty())raw+="\n二维码内容："+qr;
+                    reply(rid,new JSONObject().put("text",raw).put("items",candidates(raw)),null);
+                }catch(Exception e){reply(rid,null,e);}finally{recognizer.close();}
+            }).addOnFailureListener(e->{recognizer.close();reply(rid,null,e);});
+        }catch(Exception e){reply(rid,null,e);}
+    }
+    private String decodeQr(File file){
+        Bitmap bitmap=null;
+        try{
+            BitmapFactory.Options o=new BitmapFactory.Options();o.inJustDecodeBounds=true;BitmapFactory.decodeFile(file.getPath(),o);
+            o.inSampleSize=Math.max(1,Math.max(o.outWidth,o.outHeight)/1600);o.inJustDecodeBounds=false;bitmap=BitmapFactory.decodeFile(file.getPath(),o);
+            int w=bitmap.getWidth(),h=bitmap.getHeight();int[] px=new int[w*h];bitmap.getPixels(px,0,w,0,0,w,h);
+            return new MultiFormatReader().decode(new BinaryBitmap(new HybridBinarizer(new RGBLuminanceSource(w,h,px)))).getText();
+        }catch(Exception ignored){return "";}finally{if(bitmap!=null)bitmap.recycle();}
+    }
+    @Override public void didReceivedNotification(int event,int eventAccount,Object... args){
