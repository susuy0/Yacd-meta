diff --git a/TMessagesProj/src/main/java/org/telegram/ui/Components/FutoonPermissionRequests.java b/TMessagesProj/src/main/java/org/telegram/ui/Components/FutoonPermissionRequests.java
new file mode 100644
index 0000000000000000000000000000000000000000..8f09f525f6d5070caeb6a842dc0f5592f871fe75
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/ui/Components/FutoonPermissionRequests.java
@@ -0,0 +1,49 @@
+package org.telegram.ui.Components;
+
+import android.app.Activity;
+import android.os.Build;
+import java.util.HashMap;
+import java.util.Map;
+import java.util.WeakHashMap;
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.futoon.FutoonMediaPolicy;
+
+/** One boundary for Android runtime requests, including dynamic Mini App requests. */
+public final class FutoonPermissionRequests {
+    private static final WeakHashMap<Activity, Map<Integer, String[]>> pending = new WeakHashMap<>();
+    private FutoonPermissionRequests() {}
+    public static void request(Activity activity, String[] permissions, int code) {
+        if (activity == null || permissions == null) return;
+        String[] allowed = FutoonMediaPolicy.allowed(permissions);
+        if (allowed.length != permissions.length) {
+            synchronized (pending) {
+                Map<Integer, String[]> requests = pending.get(activity);
+                if (requests == null) { requests = new HashMap<>(); pending.put(activity, requests); }
+                requests.put(code, permissions.clone());
+            }
+        }
+        if (allowed.length == 0 || Build.VERSION.SDK_INT < 23) {
+            AndroidUtilities.runOnUIThread(() -> activity.onRequestPermissionsResult(code, permissions,
+                    FutoonMediaPolicy.restore(permissions, new String[0], new int[0])));
+        } else {
+            activity.requestPermissions(allowed, code);
+        }
+    }
+    public static final class Result {
+        public final String[] permissions;
+        public final int[] grants;
+        Result(String[] p, int[] g) { permissions = p; grants = g; }
+    }
+    public static Result restore(Activity activity, int code, String[] permissions, int[] grants) {
+        String[] original = null;
+        synchronized (pending) {
+            Map<Integer, String[]> requests = pending.get(activity);
+            if (requests != null) {
+                original = requests.remove(code);
+                if (requests.isEmpty()) pending.remove(activity);
+            }
+        }
+        return original == null ? new Result(permissions, grants)
+                : new Result(original, FutoonMediaPolicy.restore(original, permissions, grants));
+    }
+}
