+package org.telegram.ui;
+
+import com.futoonpay.admin.ChatToolsNavigationBridge;
+import com.futoonpay.admin.ChatToolsView;
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.UserConfig;
+import org.telegram.messenger.futoon.FutoonChatPreferences;
+import org.telegram.ui.ActionBar.BottomSheet;
+import java.util.function.Consumer;
+
+public final class FutoonQuickReplies {
+    private static final java.util.LinkedHashMap<String, String[]> selections = new java.util.LinkedHashMap<>();
+    private static String selectionKey(ChatActivity parent, int account) { return account + ":" + UserConfig.getInstance(account).getClientUserId() + ":" + parent.getDialogId() + ":" + parent.getTopicId(); }
+    public static boolean show(ChatActivity parent, int account, Consumer<String> insert, Runnable originalSendOptions) {
+        if (parent == null) return false;
+        String[] previous = selections.get(selectionKey(parent, account));
+        return show(parent, account, insert, originalSendOptions, previous == null ? "" : previous[0], previous == null ? "" : previous[1]);
+    }
+    private static boolean current(ChatActivity parent, int account, long owner, long dialog, long topic) {
+        return UserConfig.getInstance(account).getClientUserId() == owner && parent.getDialogId() == dialog && parent.getTopicId() == topic
+            && parent.getParentActivity() != null && parent.getFragmentView() != null && parent.getFragmentView().getWindowToken() != null
+            && parent.isLastFragment() && !parent.isPaused();
+    }
+    private static boolean show(ChatActivity parent, int account, Consumer<String> insert, Runnable originalSendOptions, String initialTab, String initialCategory) {
+        if (parent == null || parent.getParentActivity() == null) return false;
+        AndroidUtilities.hideKeyboard(parent.getFragmentView());
+        long owner = UserConfig.getInstance(account).getClientUserId(), dialogId = parent.getDialogId(), topic = parent.getTopicId();
+        FutoonChatPreferences preferences = FutoonChatPreferences.get(account);
+        BottomSheet[] sheet = new BottomSheet[1]; Runnable[] after = new Runnable[1];
+        String[] selection = { initialTab, initialCategory };
+        ChatToolsView tools = new ChatToolsView(parent.getParentActivity(), new ChatToolsNavigationBridge() {
+            public String load() { return preferences.raw(); }
+            public void save(String json) throws Exception { preferences.save(account, json); }
+            public String accountLabel() { return "当前 Telegram 账号 · ID " + owner; }
+            public String selectedTab() { return selection[0]; }
+            public String selectedCategory() { return selection[1]; }
+            public void rememberSelection(String tab, String category) {
+                selection[0] = tab; selection[1] = category;
+                String key = account + ":" + owner + ":" + dialogId + ":" + topic;
+                selections.put(key, new String[]{tab, category});
+                while (selections.size() > 64) selections.remove(selections.keySet().iterator().next());
+            }
+            public void selectReply(String text) { if (text == null || text.length() > 4096) return; after[0] = () -> insert.accept(text); close(); }
+            public void manage() { manageAt(selection[0], selection[1]); }
+            public void manageAt(String tab, String category) {
+                after[0] = () -> {
+                    FutoonChatSettingsActivity[] settings = new FutoonChatSettingsActivity[1];
+                    settings[0] = new FutoonChatSettingsActivity(account, tab, category, () -> {
+                        if (current(parent, account, owner, dialogId, topic)) show(parent, account, insert, originalSendOptions, settings[0].selectedTab(), settings[0].selectedCategory());
+                    });
+                    parent.presentFragment(settings[0]);
+                };
+                close();
+            }
+            public void originalSendOptions() { after[0] = originalSendOptions; close(); }
+            public void close() { if (sheet[0] != null) sheet[0].dismiss(); }
+        }, true);
+        FutoonThemeBridge.bind(tools, tools::setThemeColors);
+        tools.setPanelHeight(Math.min(AndroidUtilities.dp(560), (int) (AndroidUtilities.displaySize.y * .72f)));
+        sheet[0] = new BottomSheet.Builder(parent.getParentActivity()).setCustomView(tools).create();
+        if (parent.showDialog(sheet[0], dismissed -> {
+            tools.close(); Runnable action = after[0]; after[0] = null;
+            if (action != null) AndroidUtilities.runOnUIThread(() -> { if (current(parent, account, owner, dialogId, topic)) action.run(); }, 100);
+        }) == null) { sheet[0].dismiss(); tools.close(); return false; }
+        tools.onShown(); return true;
+    }
+}
