+    private interface Done<T> { void accept(T value); }
+    private <T> void runTask(Callable<T> task, Done<T> done) {
+        if (busy || isFinished) return;
+        busy = true;
+        int requestGeneration = ++generation;
+        feedback.setText("处理中…");
+        setButtonsEnabled(content, false);
+        WORK.execute(() -> {
+            T result = null; Exception failure = null;
+            try { result = task.call(); } catch (Exception exception) { failure = exception; }
+            T value = result; Exception error = failure;
+            AndroidUtilities.runOnUIThread(() -> {
+                if (requestGeneration != generation || isFinished || ownerUserId != UserConfig.getInstance(currentAccount).getClientUserId()) return;
+                busy = false;
+                setButtonsEnabled(content, true);
+                if (error != null) {
+                    if (error instanceof FutoonApi.SessionExpired) showLogin();
