+package org.telegram.ui;
+
+import android.view.View;
+import java.util.function.Consumer;
+import org.json.JSONObject;
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.NotificationCenter;
+import org.telegram.ui.ActionBar.Theme;
+
+/** Reads the active Telegram theme without changing its global keys or account settings. */
+public final class FutoonThemeBridge implements View.OnAttachStateChangeListener, NotificationCenter.NotificationCenterDelegate {
+    private final View view;
+    private final Consumer<String> receiver;
+    private boolean observing;
+    private FutoonThemeBridge(View view, Consumer<String> receiver) { this.view = view; this.receiver = receiver; }
+    public static void bind(View view, Consumer<String> receiver) {
+        FutoonThemeBridge bridge = new FutoonThemeBridge(view, receiver);
+        view.addOnAttachStateChangeListener(bridge);
+        bridge.apply();
+        if (view.isAttachedToWindow()) bridge.onViewAttachedToWindow(view);
+    }
+    private void apply() {
+        try {
+            JSONObject colors = new JSONObject().put("dark", Theme.isCurrentThemeDark())
+                .put("surface", Theme.getColor(Theme.key_windowBackgroundWhite))
+                .put("background", Theme.getColor(Theme.key_windowBackgroundGray))
+                .put("text", Theme.getColor(Theme.key_windowBackgroundWhiteBlackText))
+                .put("secondaryText", Theme.getColor(Theme.key_windowBackgroundWhiteGrayText2))
+                .put("accent", Theme.getColor(Theme.key_featuredStickers_addButton))
+                .put("accentText", Theme.getColor(Theme.key_windowBackgroundWhiteBlueText4))
+                .put("buttonText", Theme.getColor(Theme.key_featuredStickers_buttonText))
+                .put("divider", Theme.getColor(Theme.key_divider))
+                .put("error", Theme.getColor(Theme.key_text_RedRegular))
+                .put("success", Theme.getColor(Theme.key_windowBackgroundWhiteGreenText2));
+            receiver.accept(colors.toString());
+        } catch (org.json.JSONException e) { throw new IllegalStateException("Unable to read Telegram theme", e); }
+    }
+    @Override public void onViewAttachedToWindow(View target) {
+        if (!observing) { NotificationCenter.getGlobalInstance().addObserver(this, NotificationCenter.didSetNewTheme); observing = true; }
+        apply();
+    }
+    @Override public void onViewDetachedFromWindow(View target) {
+        if (observing) { NotificationCenter.getGlobalInstance().removeObserver(this, NotificationCenter.didSetNewTheme); observing = false; }
+    }
+    @Override public void didReceivedNotification(int id, int account, Object... args) { if (id == NotificationCenter.didSetNewTheme) AndroidUtilities.runOnUIThread(() -> { if (view.isAttachedToWindow()) apply(); }); }
+}
