@@ -0,0 +1,51 @@
+package org.telegram.messenger.futoon;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.HashSet;
+import java.util.Set;
+
+/** Product capabilities. Image editing and media playback are intentionally retained. */
+public final class FutoonMediaPolicy {
+    private FutoonMediaPolicy() {}
+    public static final boolean CAMERA_CAPTURE = false;
+    public static final boolean LOCATION_SHARING = false;
+    public static final boolean VIDEO_EDITING = false;
+    private static final Set<String> BLOCKED = new HashSet<>(Arrays.asList(
+        "android.permission.CAMERA", "android.permission.RECORD_AUDIO",
+        "android.permission.ACCESS_FINE_LOCATION", "android.permission.ACCESS_COARSE_LOCATION",
+        "android.permission.ACCESS_BACKGROUND_LOCATION", "android.permission.ACCESS_MEDIA_LOCATION",
+        "android.permission.READ_MEDIA_VIDEO", "android.permission.FOREGROUND_SERVICE_CAMERA",
+        "android.permission.FOREGROUND_SERVICE_MICROPHONE", "android.permission.FOREGROUND_SERVICE_LOCATION"
+    ));
+    public static boolean blocked(String permission) { return BLOCKED.contains(permission); }
+    public static boolean containsBlocked(String[] permissions) {
+        if (permissions != null) for (String permission : permissions) if (blocked(permission)) return true;
+        return false;
+    }
+    public static String[] allowed(String[] permissions) {
+        ArrayList<String> allowed = new ArrayList<>();
+        if (permissions != null) for (String permission : permissions) if (!blocked(permission)) allowed.add(permission);
+        return allowed.toArray(new String[0]);
+    }
+    public static boolean canReadImageLibrary(int sdk, boolean imagesGranted, boolean storageGranted) {
+        return sdk < 23 || (sdk < 33 ? storageGranted : imagesGranted);
+    }
+    public static boolean canReadVideoLibrary(int sdk, boolean storageGranted) {
+        return sdk < 23 || sdk < 33 && storageGranted;
+    }
+    /** Preserve original indices and treat missing/cancelled results as denied. */
+    public static int[] restore(String[] original, String[] returned, int[] grants) {
+        if (original == null) return new int[0];
+        int[] result = new int[original.length];
+        Arrays.fill(result, -1);
+        if (returned == null || grants == null) return result;
+        for (int i = 0; i < original.length; i++) {
+            if (blocked(original[i])) continue;
+            for (int k = 0; k < returned.length && k < grants.length; k++) {
+                if (original[i].equals(returned[k])) { result[i] = grants[k]; break; }
+            }
+        }
+        return result;
+    }
+}
