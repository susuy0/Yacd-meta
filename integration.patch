new file mode 100644
index 0000000000000000000000000000000000000000..c91fa0cbebdf969d417a43a27eb433dee98a9cf0
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/ui/FutoonThemeBridge.java
@@ -0,0 +1,62 @@
+package org.telegram.ui;
+
+import android.view.View;
+import java.util.function.Consumer;
+import org.json.JSONObject;
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.NotificationCenter;
+import org.telegram.ui.ActionBar.Theme;
+
+/** Reads the active Telegram theme without changing its global keys or account settings. */
+public final class FutoonThemeBridge implements View.OnAttachStateChangeListener, NotificationCenter.NotificationCenterDelegate {
+    private final View view;
+    private final Consumer<String> receiver;
+    private boolean observing;
+    private final int currentAccount;
+    private static final java.util.WeakHashMap<View, java.lang.ref.WeakReference<FutoonThemeBridge>> views = new java.util.WeakHashMap<>();
+    private FutoonThemeBridge(View view, Consumer<String> receiver, int account) { this.view = view; this.receiver = receiver; currentAccount = account; }
+    public static void bind(View view, Consumer<String> receiver) {
+        bind(view, receiver, org.telegram.messenger.UserConfig.selectedAccount);
+    }
+    public static void bind(View view, Consumer<String> receiver, int account) {
+        FutoonThemeBridge bridge = new FutoonThemeBridge(view, receiver, account);
+        views.put(view, new java.lang.ref.WeakReference<>(bridge));
+        view.addOnAttachStateChangeListener(bridge);
+        bridge.apply();
+        if (view.isAttachedToWindow()) bridge.onViewAttachedToWindow(view);
+    }
+    public static void refresh(View view) { java.lang.ref.WeakReference<FutoonThemeBridge> reference = views.get(view); FutoonThemeBridge bridge = reference == null ? null : reference.get(); if (bridge != null) bridge.apply(); }
+    private void apply() {
+        try {
+            JSONObject colors = new JSONObject().put("dark", Theme.isCurrentThemeDark())
+                .put("surface", Theme.getColor(Theme.key_windowBackgroundWhite))
+                .put("background", Theme.getColor(Theme.key_windowBackgroundGray))
+                .put("text", Theme.getColor(Theme.key_windowBackgroundWhiteBlackText))
+                .put("secondaryText", Theme.getColor(Theme.key_windowBackgroundWhiteGrayText2))
+                .put("accent", Theme.getColor(Theme.key_featuredStickers_addButton))
+                .put("accentText", Theme.getColor(Theme.key_windowBackgroundWhiteBlueText4))
+                .put("buttonText", Theme.getColor(Theme.key_featuredStickers_buttonText))
+                .put("divider", Theme.getColor(Theme.key_divider))
+                .put("error", Theme.getColor(Theme.key_text_RedRegular))
+                .put("success", Theme.getColor(Theme.key_windowBackgroundWhiteGreenText2));
+            com.futoonpay.admin.AppearanceOptions appearance = org.telegram.messenger.futoon.FutoonChatPreferences.get(currentAccount).options().getAppearance();
+            if (!appearance.getTheme().equals("telegram")) {
+                boolean dark = appearance.getTheme().equals("dark");
+                colors.put("dark", dark).put("surface", com.futoonpay.admin.appearance.ChatLook.surface(dark)).put("background", com.futoonpay.admin.appearance.ChatLook.background(dark))
+                    .put("text", com.futoonpay.admin.appearance.ChatLook.text(dark)).put("secondaryText", com.futoonpay.admin.appearance.ChatLook.secondary(dark))
+                    .put("divider", com.futoonpay.admin.appearance.ChatLook.field(dark)).put("accent", com.futoonpay.admin.appearance.ChatLook.accent(dark)).put("accentText", com.futoonpay.admin.appearance.ChatLook.accentText(dark));
+            }
+            if (!appearance.getAccent().isEmpty()) { int accent = android.graphics.Color.parseColor(appearance.getAccent()); colors.put("accent", accent).put("accentText", accent); }
+            colors.put("fontScale", appearance.getFont() / 100f);
+            receiver.accept(colors.toString());
+        } catch (org.json.JSONException e) { throw new IllegalStateException("Unable to read Telegram theme", e); }
+    }
+    @Override public void onViewAttachedToWindow(View target) {
+        if (!observing) { NotificationCenter.getGlobalInstance().addObserver(this, NotificationCenter.didSetNewTheme); observing = true; }
+        apply();
+    }
+    @Override public void onViewDetachedFromWindow(View target) {
+        if (observing) { NotificationCenter.getGlobalInstance().removeObserver(this, NotificationCenter.didSetNewTheme); observing = false; }
+    }
+    @Override public void didReceivedNotification(int id, int account, Object... args) { if (id == NotificationCenter.didSetNewTheme) AndroidUtilities.runOnUIThread(() -> { if (view.isAttachedToWindow()) apply(); }); }
+}
