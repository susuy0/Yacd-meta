    "deobfuscated_container": "org.telegram.ui.ActionBar.BottomSheet$1",
    "cause": "Compose resolves its default window recomposer on the ownerless content root above the nested lifecycle-owned panel.",
    "fix": "Prepare an explicit lifecycle-aware parent composition before BOTH onMeasure and onAttachedToWindow; retain a live recomposer between measurements, cancel/detach correctly and remove permanently closed Compose children."
  },
  "quick_reply_and_media_fix": {
    "affected_versionCode": 71869,
    "cause": "BottomSheet.show synchronously measures before first traversal; earlier onAttached binding occurs too late and BaseFragment.showDialog catches the exception. Normal chats also lacked side-button wiring while send state hid the inline media entry.",
    "changes": [
      "prepare composition before premeasurement and attachment in both embedded roots",
      "wire native side media controls in normal Lite chats and retain them for empty/typed drafts",
      "hide keyboard before picker presentation; dismiss partial windows and show a retry message on failure"
    ]
  },
